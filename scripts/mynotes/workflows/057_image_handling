// ============================================================================
// EXAMPLE 5: Conditional image generation
// ============================================================================
{
  "workflow_name": "conditional_image_generation",
  "description": "Generate image only if content meets criteria",
  "workflow": {
    "start_step": "generate_content",
    "steps": {
      "generate_content": {
        "action": "execute_llm_prompt",
        "description": "Generate marketing content",
        "config": {
          "prompt": "Write marketing copy for {{.business_name}}",
          "temperature": 0.7
        },
        "next_step": "check_content_quality"
      },
      "check_content_quality": {
        "action": "evaluate_condition",
        "description": "Check if content quality warrants image",
        "config": {
          "condition": "{{.generate_content.word_count}} > 100",
          "true_next": "generate_image",
          "false_next": "complete"
        }
      },
      "generate_image": {
        "action": "generate_image",
        "description": "Generate supporting image",
        "config": {
          "prompt": "Visual representation of {{.business_name}}, high quality",
          "style": "photographic"
        },
        "next_step": "complete"
      },
      "complete": {
        "action": "complete_workflow",
        "description": "Return content with optional image"
      }
    }
  }
}

// ============================================================================
// EXAMPLE 6: Image generation with retry logic
// ============================================================================
{
  "workflow_name": "image_with_retry",
  "description": "Generate image with fallback options",
  "workflow": {
    "start_step": "try_primary_image",
    "steps": {
      "try_primary_image": {
        "action": "generate_image",
        "description": "Attempt primary image generation",
        "config": {
          "prompt": "{{.image_prompt}}",
          "style": "photographic",
          "on_error": "try_alternative_style"
        },
        "next_step": "complete"
      },
      "try_alternative_style": {
        "action": "generate_image",
        "description": "Fallback to alternative style",
        "config": {
          "prompt": "{{.image_prompt}}",
          "style": "digital-art"
        },
        "next_step": "complete"
      },
      "complete": {
        "action": "complete_workflow",
        "description": "Return generated image"
      }
    }
  }
}

// ============================================================================
// USAGE NOTES
// ============================================================================

/*
Key Configuration Options for generate_image action:

Required:
- prompt: string - The text description of the image to generate
  Can use template variables like {{.business_name}}

Optional:
- style: string - Image style preset (photographic, digital-art, enhance, etc.)
- aspect_ratio: string - Image dimensions (1:1, 16:9, 9:16, etc.)
- seed: number - Random seed for reproducible generation
- adapter_topic: string - Override default adapter topic

Response Fields:
- image_uri: string - URL to the generated image in object storage
- prompt: string - The prompt that was used
- status: string - Generation status (complete, error, etc.)
- request_id: string - Request tracking ID

Integration Patterns:

1. Sequential: Generate content first, then matching image
2. Parallel: Generate multiple images concurrently
3. Derived: Use AI output to create image prompt
4. Conditional: Generate image based on criteria
5. Retry: Fallback logic for failed generations

Topic Configuration:
- Image adapter listens on: system.adapter.image-generator.requests
- Responses sent to: Parent agent's response topic (from ExecutionContext)
*/