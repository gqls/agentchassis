// Example workflow configurations for image generation
// These show different patterns for integrating the image adapter

// ============================================================================
// EXAMPLE 1: Simple hero section with image generation
// ============================================================================
{
  "workflow_name": "hero_section_with_image",
  "description": "Generate hero section content and accompanying image",
  "workflow": {
    "start_step": "generate_hero_text",
    "steps": {
      "generate_hero_text": {
        "action": "execute_llm_prompt",
        "description": "Generate compelling hero section text",
        "config": {
          "prompt": "Write a compelling hero section for {{.business_name}}, a {{.business_type}}. Include a powerful headline and tagline.",
          "temperature": 0.7
        },
        "next_step": "generate_hero_image"
      },
      "generate_hero_image": {
        "action": "generate_image",
        "description": "Generate hero image based on business description",
        "config": {
          "prompt": "Professional hero image for {{.business_name}}, {{.business_type}}, high quality, vibrant colors, modern style",
          "style": "photographic",
          "aspect_ratio": "16:9"
        },
        "next_step": "combine_results"
      },
      "combine_results": {
        "action": "aggregate_data",
        "description": "Combine text and image into final hero section",
        "config": {
          "strategy": "merge_fields",
          "sources": ["generate_hero_text", "generate_hero_image"]
        },
        "next_step": "complete"
      },
      "complete": {
        "action": "complete_workflow",
        "description": "Return completed hero section with image"
      }
    }
  }
}

// ============================================================================
// EXAMPLE 2: Generate image from AI-generated description
// ============================================================================
{
  "workflow_name": "content_then_image",
  "description": "Generate content first, then create matching image",
  "workflow": {
    "start_step": "generate_description",
    "steps": {
      "generate_description": {
        "action": "execute_llm_prompt",
        "description": "Create detailed image description",
        "config": {
          "prompt": "Create a detailed visual description for an image representing {{.business_name}}. Focus on colors, mood, style, and key visual elements. The description should be suitable for an image generator.",
          "temperature": 0.8
        },
        "next_step": "generate_image_from_description"
      },
      "generate_image_from_description": {
        "action": "generate_image_from_step",
        "description": "Generate image using AI-created description",
        "config": {
          "source_step": "generate_description",
          "prompt_field": "result",
          "style": "digital-art"
        },
        "next_step": "complete"
      },
      "complete": {
        "action": "complete_workflow",
        "description": "Return image with its description"
      }
    }
  }
}

// ============================================================================
// EXAMPLE 3: Multi-section website with images
// ============================================================================
{
  "workflow_name": "multi_section_website_with_images",
  "description": "Enhanced multi-section website builder with image generation",
  "workflow": {
    "start_step": "spawn_hero_writer",
    "steps": {
      "spawn_hero_writer": {
        "action": "spawn_agent",
        "description": "Spawn hero section writer agent",
        "config": {
          "agent_type": "content-creator-hero",
          "role": "hero_writer"
        },
        "next_step": "spawn_features_writer"
      },
      "spawn_features_writer": {
        "action": "spawn_agent",
        "description": "Spawn features section writer agent",
        "config": {
          "agent_type": "content-creator-features",
          "role": "features_writer"
        },
        "next_step": "spawn_image_generator"
      },
      "spawn_image_generator": {
        "action": "spawn_agent",
        "description": "Spawn image generator coordinator",
        "config": {
          "agent_type": "image-coordinator",
          "role": "image_generator"
        },
        "next_step": "generate_hero_content"
      },
      "generate_hero_content": {
        "action": "call_agent",
        "description": "Generate hero section content",
        "config": {
          "target_role": "hero_writer",
          "agent_type": "content-creator-hero",
          "prompt": "Write compelling hero section for {{.business_name}}"
        },
        "next_step": "generate_hero_image"
      },
      "generate_hero_image": {
        "action": "generate_image",
        "description": "Generate hero section image",
        "config": {
          "prompt": "Professional hero banner for {{.business_name}}, a {{.business_type}}, vibrant, modern, high quality, 16:9 aspect ratio",
          "aspect_ratio": "16:9",
          "style": "photographic"
        },
        "next_step": "generate_features_content"
      },
      "generate_features_content": {
        "action": "call_agent",
        "description": "Generate features section content",
        "config": {
          "target_role": "features_writer",
          "agent_type": "content-creator-features",
          "prompt": "Write features section for {{.business_name}}"
        },
        "next_step": "generate_feature_icons"
      },
      "generate_feature_icons": {
        "action": "generate_image",
        "description": "Generate feature section icons",
        "config": {
          "prompt": "Simple icon set for {{.business_type}} features, clean, minimal, professional",
          "style": "digital-art",
          "aspect_ratio": "1:1"
        },
        "next_step": "aggregate_all_sections"
      },
      "aggregate_all_sections": {
        "action": "aggregate_data",
        "description": "Combine all sections with images",
        "config": {
          "strategy": "build_website",
          "sections": [
            "generate_hero_content",
            "generate_hero_image",
            "generate_features_content",
            "generate_feature_icons"
          ]
        },
        "next_step": "complete"
      },
      "complete": {
        "action": "complete_workflow",
        "description": "Return complete website with images"
      }
    }
  }
}

