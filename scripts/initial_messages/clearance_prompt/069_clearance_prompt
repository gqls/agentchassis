# 1. FIRST - Stop all consumers by scaling down deployments
kubectl -n ai-persona-system scale deployment/agent-chassis --replicas=0
# Wait for pods to terminate
kubectl -n ai-persona-system wait --for=delete pod -l app=agent-chassis --timeout=60s

# Clean up any leftover kcat pods
kubectl -n kafka delete pod kcat-producer-hitl-test --ignore-not-found=true 2>/dev/null || true
kubectl -n kafka delete pod kcat-test --ignore-not-found=true 2>/dev/null || true

# 3. Clear database tables
kubectl -n ai-persona-system exec postgres-clients-0 -- psql -U clients_user -d clients_db -c "TRUNCATE TABLE processed_messages, orchestration_states, pending_requests, orchestration_state_audit, awaited_requests CASCADE;"

# 4. Delete ALL spawned agent jobs
kubectl -n ai-persona-system delete jobs -l spawned-by=orchestrator

# scale other agents down
kubectl -n ai-persona-system scale deployment/reasoning-agent --replicas=0
kubectl -n ai-persona-system scale deployment/content-creator-agent --replicas=0
kubectl -n ai-persona-system scale deployment/web-scrape-adapter --replicas=0
kubectl -n ai-persona-system scale deployment/business-intel --replicas=0

kubectl -n ai-persona-system scale deployment/web-search-adapter --replicas=1
kubectl -n ai-persona-system scale deployment/web-scrape-adapter --replicas=1

# adapters
