# Clean old ReplicaSets — keep only the active ones
# Agent chassis
kubectl -n ai-persona-system get rs -l app=agent-chassis --no-headers | \
  awk '$2==0 {print $1}' | xargs -I{} kubectl -n ai-persona-system delete rs {}

# Auth service (44 old RS)
kubectl -n ai-persona-system get rs -l app=auth-service --no-headers | \
  awk '$2==0 {print $1}' | xargs -I{} kubectl -n ai-persona-system delete rs {}

