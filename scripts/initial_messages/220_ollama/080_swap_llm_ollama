Backup first, then swap:

-- 1. Fresh backup (dated today)
CREATE TABLE agent_definitions_backup_20260326 AS SELECT * FROM agent_definitions;

-- 2. Verify
SELECT
    (SELECT COUNT(*) FROM agent_definitions) as live,
    (SELECT COUNT(*) FROM agent_definitions_backup_20260326) as backup;

-- 3. Check current briefing-agent config
SELECT type,
    default_config->'workflow'->'steps'->'infer_via_llm'->'config'->'ai_service' as current_ai_service
FROM agent_definitions
WHERE type = 'briefing-agent' AND is_active = true
  AND (is_snapshot IS NULL OR is_snapshot = false);

-- 4. Swap (snapshots automatically)
SELECT swap_agent_model(
    'briefing-agent',
    'infer_via_llm',
    '{"provider": "ollama", "model": "mistral-small3.1", "api_url": "http://ollama-adapter.ai-persona-system.svc.cluster.local:11434", "max_tokens": 1500}'::jsonb
);

-- 5. Verify swap
SELECT type,
    default_config->'workflow'->'steps'->'infer_via_llm'->'config'->'ai_service' as new_ai_service
FROM agent_definitions
WHERE type = 'briefing-agent' AND is_active = true
  AND (is_snapshot IS NULL OR is_snapshot = false);


