clients_db=# -- When did completeness discovery last run for gaswholesalers?
-- Check for ANY discovery items from the most recent cycle
SELECT source, item_type, created_at
FROM site_work_items
WHERE site_id = '5fe15466-4e2e-4ff2-981e-98c1b7074002'
  AND source = 'discovery'
  AND created_at > NOW() - INTERVAL '6 hours'
ORDER BY created_at DESC
LIMIT 10;

-- Is the check registered and does the code match what we expect?
-- Check the completeness-discovery-agent checks list
SELECT default_config->'workflow'->'steps'->'run_checks'->'config'->'checks' as checks
FROM agent_definitions
WHERE type = 'completeness-discovery-agent' AND deleted_at IS NULL;

-- Has the audit pass limit been reached? (would skip discovery)
SELECT get_audit_pass_count('5fe15466-4e2e-4ff2-981e-98c1b7074002') as pass_count;
