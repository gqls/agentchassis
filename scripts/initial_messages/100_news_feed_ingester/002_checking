clients_db=# -- Did missing_news_page discovery check fire?
SELECT item_type, handler_agent, status, created_at
FROM site_work_items
WHERE site_id = '5fe15466-4e2e-4ff2-981e-98c1b7074002'
  AND item_type = 'missing_news_page'
ORDER BY created_at DESC LIMIT 3;

-- Did a news page get created?
SELECT name, page_type, url, build_status
FROM pages
WHERE site_id = '5fe15466-4e2e-4ff2-981e-98c1b7074002'
  AND (page_type = 'news-index' OR name = 'news');

-- Any errors from the check?
SELECT error_message, occurred_at
FROM agent_error_log
WHERE error_message LIKE '%news_page%'
  AND occurred_at > NOW() - INTERVAL '6 hours'
ORDER BY occurred_at DESC LIMIT 3;
