-- Top postcodes
SELECT postcode_prefix, COUNT(*)
FROM business_intel.ch_vet_companies
WHERE postcode_prefix IS NOT NULL
GROUP BY postcode_prefix
ORDER BY COUNT(*) DESC
LIMIT 10;

-- Quick match preview against our businesses
SELECT COUNT(*) as potential_matches
FROM business_intel.ch_vet_companies ch
JOIN business_intel.businesses b
  ON ch.postcode_prefix = SPLIT_PART(UPPER(b.postcode), ' ', 1)
WHERE ch.company_status = 'active'
  AND b.verification_status = 'verified';