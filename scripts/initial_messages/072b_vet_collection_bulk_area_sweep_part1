#!/bin/bash
# start_area_sweep.sh - Kick off the area sweep orchestrator
#
# Usage:
#   ./start_area_sweep.sh            # sweep 50 districts (default)
#   ./start_area_sweep.sh 10         # sweep 10 districts
#   ./start_area_sweep.sh 100 BT     # sweep 100 districts, Belfast area only

LIMIT=${1:-50}
AREA_CODE=${2:-}


LIMIT=2
AREA_CODE='BT'
ORCH_ID=$(uuidgen)
REQ_ID=$(uuidgen)
CORR_ID=$(uuidgen)
MSG_ID=$(uuidgen)
ORCH_NAME="area-sweep-$(date +%Y%m%d-%H%M%S)"

BOOTSTRAP="personae-kafka-cluster-kafka-bootstrap.kafka.svc.cluster.local:9092"
TOPIC="system.agent.generic.requests"

# Build input_data
if [ -n "$AREA_CODE" ]; then
    INPUT="\"limit\":${LIMIT},\"country\":\"GB\",\"area_code\":\"${AREA_CODE}\""
else
    INPUT="\"limit\":${LIMIT},\"country\":\"GB\""
fi

BODY="{\"action\":\"orchestrate\",\"config\":{\"agent_type\":\"area-sweep-orchestrator\"},\"input_data\":{${INPUT}}}"

echo "Sending area sweep request:"
echo "  Limit: $LIMIT"
echo "  Area:  ${AREA_CODE:-all}"
echo "  Orch:  $ORCH_NAME"
echo ""

kubectl -n kafka run kcat-sweep-$$ \
    --image=edenhill/kcat:1.7.1 \
    --restart=Never \
    --rm -i \
    --command -- kcat -P \
    -b "$BOOTSTRAP" \
    -t "$TOPIC" \
    -H "correlation_id=$CORR_ID" \
    -H "request_id=$REQ_ID" \
    -H "message_id=$MSG_ID" \
    -H "orchestration_id=$ORCH_ID" \
    -H "orchestration_name=$ORCH_NAME" \
    -H "step_name=start" \
    -H "client_id=00000000-0000-0000-0000-000000000001" \
    -H "message_type=request" \
    -H "action=orchestrate" \
    -H "from_agent_type=user" \
    -H "from_agent_id=cli-sweep" \
    -H "responses_topic=system.generic.responses" \
    <<< "$BODY"

echo ""
echo "Sent. The orchestrator will load ${LIMIT} un-swept districts and dispatch discoverers."
echo ""
echo "Monitor:"
echo "  kubectl -n ai-persona-system exec postgres-clients-0 -- psql -U clients_user -d clients_db -c \\"
echo "    \"SELECT status, COUNT(*) FROM orchestration_states WHERE orchestration_name LIKE '${ORCH_NAME}%' GROUP BY status;\""


