 -- Step 2: Create nav_drift work items for sites that need nav rebuilding
 -- Run after confirming step 1 shows the expected pages

 INSERT INTO site_work_items (
     site_id, source, pipeline, item_type, severity, summary,
     priority, handler_agent, status, created_by,
     spec, item_key
 )
 SELECT DISTINCT
     s.id,
     'manual',
     'build',
     'nav_drift',
     'high',
     'Manual trigger: rebuild nav tables for pages with nav flags missing from navigation',
     20,
     'nav-updater',
     'triaged',
     'manual-script',
     jsonb_build_object(
         'check', 'orphan_pages',
         'orphan_type', 'nav_drift',
         'fix', 'Nav tables need rebuilding'
     ),
     'nav_drift:' || s.id::text
 FROM sites s
 WHERE s.domain IN ('robot-hands.com', 'finetuning.uk', 'leopardessconsulting.co.uk', 'gaswholesalers.com')
   AND s.status = 'active'
   AND NOT EXISTS (
       SELECT 1 FROM site_work_items swi
       WHERE swi.site_id = s.id
         AND swi.item_type = 'nav_drift'
         AND swi.status IN ('triaged', 'claimed', 'detected')
   );


