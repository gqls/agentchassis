-- Step 1: Check which sites have nav drift (pages with nav flags missing from nav)
-- Run this first to see what we're working with

SELECT s.id as site_id, s.domain, p.name as page_name, p.url,
       p.in_header, p.in_footer
FROM pages p
JOIN sites s ON p.site_id = s.id
WHERE s.domain IN ('robot-hands.com', 'finetuning.uk', 'leopardessconsulting.co.uk', 'gaswholesalers.com')
  AND s.status = 'active'
  AND p.build_status = 'deployed'
  AND (p.in_header = true OR p.in_footer = true)
  AND NOT EXISTS (
      SELECT 1 FROM site_nav_items sni
      WHERE sni.site_id = p.site_id
        AND (sni.url = p.url OR sni.page_id = p.id)
        AND sni.status = 'active'
  )
ORDER BY s.domain, p.name;

