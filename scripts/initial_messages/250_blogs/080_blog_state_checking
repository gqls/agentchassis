clients_db=# -- 1. What does the blog-index page look like for finetuning.uk?
SELECT p.id, p.name, p.url, p.page_type, p.build_status, p.sections
FROM pages p
JOIN sites s ON p.site_id = s.id
WHERE s.domain = 'finetuning.uk'
  AND (p.page_type = 'blog-index' OR p.name = 'blog')
LIMIT 5;

-- 2. Does the blog page have a listing component?
SELECT pc.id, pc.slot_name, pc.build_status, 
       LENGTH(pc.rendered_html) as html_len,
       pc.content_data IS NOT NULL as has_content_data,
       pc.updated_at
FROM page_components pc
JOIN pages p ON pc.page_id = p.id
JOIN sites s ON p.site_id = s.id
WHERE s.domain = 'finetuning.uk'
  AND (p.page_type = 'blog-index' OR p.name = 'blog')
ORDER BY pc.slot_name;

-- 3. Is blog in the nav?
SELECT sni.label, sni.url, sni.in_header, sni.in_footer
FROM site_nav_items sni
JOIN site_nav_groups sng ON sni.group_id = sng.id
JOIN sites s ON sng.site_id = s.id
WHERE s.domain = 'finetuning.uk'
ORDER BY sni.position;

-- 4. Anything stuck in claimed for finetuning.uk?
SELECT swi.item_type, swi.status, swi.handler_agent, swi.claimed_at, swi.claimed_by
FROM site_work_items swi
JOIN sites s ON swi.site_id = s.id
WHERE s.domain = 'finetuning.uk'
  AND swi.status = 'claimed';

-- 5. Current status of the orphan_blog_posts and nav_drift items
SELECT swi.item_type, swi.status, swi.attempt_count, swi.max_attempts, swi.error, swi.updated_at
FROM site_work_items swi
ORDER BY swi.item_type, swi.updated_at DESC; 'nav_drift')
