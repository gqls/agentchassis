-- ============================================================================
-- Site cleanup: gamesdesign.co.uk
-- ============================================================================
-- Removes the site, its pages/components/specs (via cascade), the work_items
-- and feed/maintenance rows (no cascade, manual), and the design library rows
-- attributed to this domain (style_collections, css_themes, palettes,
-- typography_sets, layouts).
--
-- Preserves baseline layouts shared across sites.
--
-- Run inside a transaction so we can roll back if anything looks off.
-- ============================================================================

BEGIN;

-- ──────────────────────────────────────────────────────────────────────
-- Step 0: confirm what we're about to delete
-- ──────────────────────────────────────────────────────────────────────
SELECT id, domain, status, style_collection_id, created_at
FROM sites
WHERE domain = 'gamesdesign.co.uk';
-- Expect 0 or 1 row. If 2+, abort (ROLLBACK).

-- ──────────────────────────────────────────────────────────────────────
-- Step 1: break non-cascading FKs that would block the delete
-- ──────────────────────────────────────────────────────────────────────

-- sites → style_collections (no ON DELETE clause, blocks delete)
UPDATE sites
SET style_collection_id = NULL
WHERE domain = 'gamesdesign.co.uk';

-- style_collections → css_themes (no ON DELETE clause, blocks delete)
-- Both linkage paths: by source_domain text AND by source_site_id
UPDATE style_collections
SET css_theme_id = NULL
WHERE source_domain = 'gamesdesign.co.uk'
   OR source_site_id IN (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk');

-- ──────────────────────────────────────────────────────────────────────
-- Step 2: delete child tables that don't cascade
-- ──────────────────────────────────────────────────────────────────────
WITH s AS (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk')
DELETE FROM site_work_items        WHERE site_id IN (SELECT id FROM s);

WITH s AS (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk')
DELETE FROM content_feed_items     WHERE site_id IN (SELECT id FROM s);

WITH s AS (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk')
DELETE FROM maintenance_queue      WHERE site_id IN (SELECT id FROM s);

WITH s AS (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk')
DELETE FROM page_component_history WHERE site_id IN (SELECT id FROM s);

WITH s AS (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk')
DELETE FROM link_registry          WHERE target_site_id IN (SELECT id FROM s);

-- ──────────────────────────────────────────────────────────────────────
-- Step 3: delete the site row
--   Cascades through: pages, site_specs, site_components, site_areas,
--   site_nav_items, site_nav_groups, site_snapshots, site_flows,
--   navigation_structures, research_results, redirects, products,
--   content_items, content_sources, assets, affiliate_products,
--   link_registry (via source_site_id).
--   Sets NULL on: palettes, typography_sets, layouts, css_themes,
--   style_collections via source_site_id (we delete these by
--   source_domain in Step 4).
-- ──────────────────────────────────────────────────────────────────────
DELETE FROM sites WHERE domain = 'gamesdesign.co.uk';

-- ──────────────────────────────────────────────────────────────────────
-- Step 4: delete library rows attributed to this domain
--   Layouts excludes the baseline shared collection.
-- ──────────────────────────────────────────────────────────────────────
DELETE FROM style_collections WHERE source_domain = 'gamesdesign.co.uk';
DELETE FROM css_themes        WHERE source_domain = 'gamesdesign.co.uk';
DELETE FROM palettes          WHERE source_domain = 'gamesdesign.co.uk';
DELETE FROM typography_sets   WHERE source_domain = 'gamesdesign.co.uk';
DELETE FROM layouts
WHERE source_domain = 'gamesdesign.co.uk'
  AND name NOT IN (
    'tool-portal-dark', 'social-lobby', 'brochure-formal',
    'brochure-bold', 'technical-precise', 'affiliate-hub'
  );


-- Optional pre-clean (only if you want to remove the suspicious placeholder pages)
DELETE FROM pages
WHERE site_id IN (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk');

-- And their work items
DELETE FROM site_work_items
WHERE site_id IN (SELECT id FROM sites WHERE domain = 'gamesdesign.co.uk');

-- ──────────────────────────────────────────────────────────────────────
-- Step 5: verify everything is gone
-- ──────────────────────────────────────────────────────────────────────
SELECT 'sites'             AS tbl, COUNT(*) AS remaining
FROM sites             WHERE domain        = 'gamesdesign.co.uk'
UNION ALL
SELECT 'style_collections',     COUNT(*)
FROM style_collections WHERE source_domain = 'gamesdesign.co.uk'
UNION ALL
SELECT 'css_themes',            COUNT(*)
FROM css_themes        WHERE source_domain = 'gamesdesign.co.uk'
UNION ALL
SELECT 'palettes',              COUNT(*)
FROM palettes          WHERE source_domain = 'gamesdesign.co.uk'
UNION ALL
SELECT 'typography_sets',       COUNT(*)
FROM typography_sets   WHERE source_domain = 'gamesdesign.co.uk'
UNION ALL
SELECT 'layouts (non-baseline)', COUNT(*)
FROM layouts           WHERE source_domain = 'gamesdesign.co.uk'
                         AND name NOT IN ('tool-portal-dark','social-lobby','brochure-formal',
                                          'brochure-bold','technical-precise','affiliate-hub');

-- If all six remaining = 0, commit.
COMMIT;

-- If anything looks off:
-- ROLLBACK;

-- ──────────────────────────────────────────────────────────────────────
-- Post-cleanup hygiene (optional, outside transaction)
-- ──────────────────────────────────────────────────────────────────────
-- VACUUM ANALYZE sites, pages, page_components, site_specs, site_work_items;