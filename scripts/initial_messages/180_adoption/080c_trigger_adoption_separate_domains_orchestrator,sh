#!/bin/bash
# ============================================================================
# trigger-adopt-separated.sh
# ============================================================================
# Adoption trigger with SOURCE ≠ DESTINATION support (Phase 1 of
# FUTURE_adoption_source_destination_separation.md).
#
# Mirrors the envelope of your existing trigger-adopt-site.sh exactly
# (same topic, same headers, same responses_topic, same kcat pod naming).
# The only substantive difference is the input_data shape:
#
#   input_data.target_url          (the URL to crawl)
#   input_data.destination_domain  (the domain to build)
#
# When the deployed Go patch sees these fields, it:
#   - creates the site row for destination_domain
#   - crawls target_url via firecrawl
#   - writes identity.adopted_from = <host of target_url>
#   - matches crawled page content using the source host (fixed the
#     latent lookup bug where destination ≠ source)
# ============================================================================

set -euo pipefail

# ── edit these two lines per run ────────────────────────────────────────
SOURCE_URL='https://gamedesign.uk'
DEST_DOMAIN='gamesdesign.co.uk'
# ────────────────────────────────────────────────────────────────────────

CORRELATION_ID=$(cat /proc/sys/kernel/random/uuid)
ORCHESTRATION_ID=$(cat /proc/sys/kernel/random/uuid)
MESSAGE_ID=$(cat /proc/sys/kernel/random/uuid)
REQUEST_ID=$(cat /proc/sys/kernel/random/uuid)
CLIENT_ID="demo_client"

echo "========================================="
echo "Separated Adoption Trigger"
echo "========================================="
echo "  Source (crawl):      $SOURCE_URL"
echo "  Destination (build): $DEST_DOMAIN"
echo "  Correlation ID:      $CORRELATION_ID"
echo "  Orchestration ID:    $ORCHESTRATION_ID"
echo "========================================="
echo ""
echo "SAVE THESE IDs:"
echo "  CORRELATION_ID=$CORRELATION_ID"
echo "  ORCHESTRATION_ID=$ORCHESTRATION_ID"
echo ""

kubectl -n kafka run -i --rm kcat-adopt-$(date +%s) \
  --image=edenhill/kcat:1.7.1 \
  --restart=Never -- \
  kcat -P \
  -b personae-kafka-cluster-kafka-bootstrap.kafka.svc.cluster.local:9092 \
  -t system.agent.generic.requests \
  -H correlation_id=$CORRELATION_ID \
  -H request_id=$REQUEST_ID \
  -H message_id=$MESSAGE_ID \
  -H orchestration_id=$ORCHESTRATION_ID \
  -H orchestration_name=adopt-separated-$(date +%Y%m%d-%H%M%S) \
  -H step_name=start \
  -H client_id=$CLIENT_ID \
  -H message_type=request \
  -H action=orchestrate \
  -H from_agent_type=user \
  -H from_agent_id=cli \
  -H responses_topic=system.agent.generic.responses <<JSON
{"action":"orchestrate","config":{"agent_type":"site-adoption-orchestrator"},"input_data":{"target_url":"$SOURCE_URL","destination_domain":"$DEST_DOMAIN"}}
JSON

echo ""
echo "========================================="
echo "Separated adoption triggered (via orchestrator)"
echo "  Crawl:  $SOURCE_URL"
echo "  Build:  $DEST_DOMAIN"
echo "========================================="
echo ""
echo "The orchestrator spawns a dedicated pod for site-adoption-agent."
echo "Find the spawned adopter pod (usually 10-20s after trigger):"
echo "  kubectl -n ai-persona-system get pods -l agent_type=site-adoption-agent --sort-by=.metadata.creationTimestamp | tail -3"
echo ""
echo "Once you have its pod name, tail its logs directly — clean, single-correlation stream:"
echo "  kubectl -n ai-persona-system logs -f <adopter-pod-name>"
echo ""
echo "Monitor orchestrator (in agent-chassis, shorter-lived):"
echo "  kubectl -n ai-persona-system logs -f -l app=agent-chassis --tail=100 | grep '$CORRELATION_ID'"
echo ""
echo "Verify the separation took effect (both should appear):"
echo "  kubectl -n ai-persona-system logs -l app=agent-chassis --tail=500 | grep '$CORRELATION_ID' | grep 'using destination domain override'"
echo "  kubectl -n ai-persona-system logs -l app=agent-chassis --tail=500 | grep '$CORRELATION_ID' | grep 'source differs from destination'"
echo ""
echo "Watch crawl step:"
echo "  kubectl -n ai-persona-system logs -l app=agent-chassis --tail=200 | grep '$CORRELATION_ID' | grep -E 'crawl|webscrape|firecrawl'"
echo ""
echo "Watch LLM analysis:"
echo "  kubectl -n ai-persona-system logs -l app=agent-chassis --tail=200 | grep '$CORRELATION_ID' | grep -E 'analyze|adoption_analysis|execute_llm'"
echo ""
echo "Watch plan application:"
echo "  kubectl -n ai-persona-system logs -l app=agent-chassis --tail=200 | grep '$CORRELATION_ID' | grep -E 'apply_adoption|specs_written|pages_created|items_created'"
echo ""
echo "Check orchestration state:"
echo "  SELECT status, current_step, error FROM orchestration_states WHERE correlation_id = '$CORRELATION_ID'::uuid;"
echo ""
echo "Check destination site row exists:"
echo "  SELECT id, domain, status, build_status FROM sites WHERE domain = '$DEST_DOMAIN';"
echo ""
echo "Check provenance (every adopted_from should be the SOURCE host):"
echo "  SELECT aspect, data->>'adopted_from' AS adopted_from, notes"
echo "  FROM site_specs"
echo "  WHERE site_id = (SELECT id FROM sites WHERE domain = '$DEST_DOMAIN')"
echo "    AND source = 'adoption' AND is_current = true"
echo "  ORDER BY aspect;"
echo ""
echo "Check created pages (on the destination):"
echo "  SELECT name, page_type, build_status FROM pages WHERE site_id = (SELECT id FROM sites WHERE domain = '$DEST_DOMAIN') ORDER BY name;"
echo ""
echo "Check work items:"
echo "  SELECT item_type, status, handler_agent, summary FROM site_work_items WHERE site_id = (SELECT id FROM sites WHERE domain = '$DEST_DOMAIN') AND pipeline = 'build' ORDER BY priority;"



# Ordered delete:
BEGIN;

-- Confirm we're about to delete the right site
SELECT id, domain, created_at FROM sites WHERE id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';

-- Clear the 4 NO ACTION blockers
DELETE FROM site_work_items         WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';
DELETE FROM maintenance_queue       WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';
DELETE FROM content_feed_items      WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';
DELETE FROM page_component_history  WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';

-- link_registry.target_site_id — are any other sites linking TO gamesdesign?
DELETE FROM link_registry
WHERE target_site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';
-- Safe to hard-delete — gamesdesign isn't up, no other site should depend on its URLs.
-- If this DELETE removes >0 rows we'll see it in the output.

-- Now the main delete — CASCADEs + SET NULLs handle the rest
DELETE FROM sites WHERE id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';

-- Orphan check — should be all zero
SELECT 'site_work_items'        AS tbl, COUNT(*) FROM site_work_items        WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'maintenance_queue',       COUNT(*) FROM maintenance_queue       WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'content_feed_items',      COUNT(*) FROM content_feed_items      WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'page_component_history',  COUNT(*) FROM page_component_history  WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'pages',                   COUNT(*) FROM pages                   WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'site_specs',              COUNT(*) FROM site_specs              WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'site_components',         COUNT(*) FROM site_components         WHERE site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'link_registry_source',    COUNT(*) FROM link_registry           WHERE source_site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18'
UNION ALL SELECT 'link_registry_target',    COUNT(*) FROM link_registry           WHERE target_site_id = '166cda1c-1f76-4013-a9b5-2da1dcdb1a18';

-- And the SET NULL tables — these rows should still exist but with NULL source_site_id
SELECT 'css_themes_orphaned'       AS tbl, COUNT(*) FROM css_themes       WHERE source_site_id IS NULL AND source_domain = 'gamesdesign.co.uk'
UNION ALL SELECT 'layouts_orphaned',       COUNT(*) FROM layouts          WHERE source_site_id IS NULL AND (source_domain = 'gamesdesign.co.uk' OR source_domain = 'gamedesign.uk')
UNION ALL SELECT 'palettes_orphaned',      COUNT(*) FROM palettes         WHERE source_site_id IS NULL;

-- If orphan counts are zero on the first block → COMMIT.
-- If anything non-zero → ROLLBACK and we investigate.

COMMIT;


Adoption fired. Orchestrator will go:

site-adoption-orchestrator
  → spawn site-adoption-agent
  → crawl gamedesign.uk (target_url)
  → extract fingerprint
  → fetch primary CSS
  → enrich fingerprint
  → analyze_site (LLM)
  → classify_archetype (LLM)
  → select_content + derive_content_direction (LLM)
  → apply_adoption_plan  ← creates destination_domain site + work item
  → populate_nav
  → generate_design_intent (LLM)
  → write design_intent spec
  → complete