# Refactored Makefile for Agent-Managed Microservices
# Reduced redundancy, improved organization, parameter-based commands

# Load environment variables from .env file
include .env
export

export TMPDIR := $(HOME)/kind-tmp

# Project variables
PROJECT_NAME := ai-persona-system
ENVIRONMENT ?= production
REGION ?= uk001
REGION_PATH ?= uk_001
REGISTRY ?= docker.io/aqls
IMAGE_TAG ?= v1.0.49

# Paths
TERRAFORM_DIR := deployments/terraform/environments/$(ENVIRONMENT)/$(REGION)
KUSTOMIZE_DIR := deployments/kustomize
SCRIPTS_DIR := scripts

# Kubeconfig
KUBECONFIG_PATH := $(HOME)/.kube/config_$(ENVIRONMENT)_$(REGION)

# Colors for output
YELLOW := \033[1;33m
GREEN := \033[1;32m
RED := \033[1;31m
NC := \033[0m # No Color

# Overlay path logic
ifeq ($(ENVIRONMENT),production)
    OVERLAY_PATH := $(ENVIRONMENT)/$(REGION_PATH)
else
    OVERLAY_PATH := $(ENVIRONMENT)
endif

# Default target
.DEFAULT_GOAL := help

#################################
# Help & Documentation
#################################
.PHONY: help
help: ## Show this help message
	@echo '$(YELLOW)AI Persona System - Makefile Commands$(NC)'
	@echo ''
	@echo 'Usage:'
	@echo '  make $(GREEN)<target>$(NC) $(YELLOW)[PARAM=value]$(NC)'
	@echo ''
	@echo 'Primary Commands:'
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | grep -E '(deploy-all|quick-deploy|build-all|status|clean):' | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(GREEN)%-20s$(NC) %s\n", $$1, $$2}'
	@echo ''
	@echo 'Categories:'
	@echo '  $(YELLOW)Infrastructure:$(NC)  deploy-infra, destroy-infra'
	@echo '  $(YELLOW)Building:$(NC)       build, push'
	@echo '  $(YELLOW)Deployment:$(NC)     deploy, restart, rollback'
	@echo '  $(YELLOW)Development:$(NC)    dev, test, logs'
	@echo '  $(YELLOW)Database:$(NC)       db-console, db-migrate'
	@echo '  $(YELLOW)Monitoring:$(NC)     status, monitor, metrics'
	@echo ''
	@echo 'For detailed help on a category, use: make help-<category>'

.PHONY: help-build
help-build: ## Show build-related commands
	@echo '$(YELLOW)Build Commands:$(NC)'
	@echo '  make build              # Build with SERVICE=name or TARGET=all|services|agents|frontends'
	@echo '  make push               # Push with SERVICE=name or TARGET=all'
	@echo '  make build-all          # Build everything'
	@echo '  make push-all           # Push everything'

.PHONY: help-deploy
help-deploy: ## Show deployment commands
	@echo '$(YELLOW)Deployment Commands:$(NC)'
	@echo '  make deploy-all         # Deploy infrastructure and applications'
	@echo '  make quick-deploy       # Deploy applications only'
	@echo '  make deploy             # Deploy with SERVICE=name or TARGET=services|agents'
	@echo '  make restart            # Restart with SERVICE=name or TARGET=all'
	@echo '  make rollback           # Rollback with SERVICE=name'

#################################
# PRIMARY WORKFLOWS (User-Facing)
#################################
.PHONY: deploy-all
deploy-all: deploy-infra deploy-apps ## Complete deployment (infrastructure + applications)

.PHONY: quick-deploy
quick-deploy: deploy-apps ## Deploy applications only (assumes infrastructure exists)

.PHONY: build-all
build-all: ## Build all images
	@$(MAKE) build TARGET=all

.PHONY: push-all
push-all: ## Push all images
	@$(MAKE) push TARGET=all

.PHONY: status
status: ## Show complete system status
	@echo "$(YELLOW)=== System Status ===$(NC)"
	@echo "\n$(GREEN)Cluster Info:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl cluster-info 2>/dev/null || echo "Cluster not accessible"
	@echo "\n$(GREEN)Deployments:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get deployments -n $(PROJECT_NAME) 2>/dev/null || true
	@echo "\n$(GREEN)StatefulSets:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get statefulsets -n $(PROJECT_NAME) 2>/dev/null || true
	@echo "\n$(GREEN)Services:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get services -n $(PROJECT_NAME) 2>/dev/null || true
	@echo "\n$(GREEN)Pods:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get pods -n $(PROJECT_NAME) --field-selector=status.phase!=Succeeded 2>/dev/null || true

.PHONY: clean
clean: ## Clean build artifacts and temporary files
	@echo "$(YELLOW)Cleaning build artifacts...$(NC)"
	@rm -rf dist/ build/ *.bak
	@rm -rf frontends/*/build/ frontends/*/dist/
	@rm -rf deployments/kustomize/**/overlays/**/*.bak
	@find . -name "*.bak" -delete
	@echo "$(GREEN)Clean complete$(NC)"

#################################
# INFRASTRUCTURE
#################################
.PHONY: deploy-infra
deploy-infra: ## Deploy complete infrastructure
	@echo "$(YELLOW)Deploying infrastructure to $(ENVIRONMENT)/$(REGION)...$(NC)"
	@for step in 010-infrastructure 020-ingress-nginx 030-strimzi-operator 040-kafka-cluster \
	            045-kafka-users 047-base-configs 050-storage 060-databases \
	            070-database-schemas 080-kafka-topics 090-monitoring 100-bootstrap-agents; do \
		echo "$(GREEN)Deploying $$step...$(NC)"; \
		$(MAKE) deploy-infra-step STEP=$$step || exit 1; \
	done
	@echo "$(GREEN)Infrastructure deployment complete!$(NC)"

.PHONY: deploy-infra-step
deploy-infra-step: ## Deploy specific infrastructure step (internal use)
	@cd $(TERRAFORM_DIR)/$(STEP) && \
		if [ -f terraform.tfvars.secret ]; then \
			KUBECONFIG=$(KUBECONFIG_PATH) terraform init -upgrade && \
			KUBECONFIG=$(KUBECONFIG_PATH) terraform apply -auto-approve -var-file=terraform.tfvars.secret; \
		else \
			KUBECONFIG=$(KUBECONFIG_PATH) terraform init -upgrade && \
			KUBECONFIG=$(KUBECONFIG_PATH) terraform apply -auto-approve; \
		fi

.PHONY: destroy-infra
destroy-infra: ## Destroy infrastructure (WARNING: Destructive!)
	@echo "$(RED)WARNING: This will destroy all infrastructure!$(NC)"
	@echo "Press Ctrl+C within 5 seconds to cancel..."
	@sleep 5
	@for step in 100-bootstrap-agents 090-monitoring 080-kafka-topics 070-database-schemas \
	            060-databases 050-storage 047-base-configs 045-kafka-users \
	            040-kafka-cluster 030-strimzi-operator 020-ingress-nginx 010-infrastructure; do \
		echo "$(RED)Destroying $$step...$(NC)"; \
		$(MAKE) destroy-infra-step STEP=$$step || true; \
	done

.PHONY: destroy-infra-step
destroy-infra-step: ## Destroy specific infrastructure step (internal use)
	@cd $(TERRAFORM_DIR)/$(STEP) && \
		if [ -f terraform.tfvars.secret ]; then \
			KUBECONFIG=$(KUBECONFIG_PATH) terraform destroy -auto-approve -var-file=terraform.tfvars.secret; \
		else \
			KUBECONFIG=$(KUBECONFIG_PATH) terraform destroy -auto-approve; \
		fi

#################################
# BUILD & PUSH (Parameterized)
#################################
.PHONY: build
build: ## Build images (SERVICE=name or TARGET=all|services|agents|frontends)
	@if [ -n "$(SERVICE)" ]; then \
		$(MAKE) build-single SERVICE=$(SERVICE); \
	elif [ "$(TARGET)" = "all" ]; then \
		$(MAKE) build-services build-agents build-frontends; \
	elif [ "$(TARGET)" = "services" ]; then \
		$(MAKE) build-services; \
	elif [ "$(TARGET)" = "agents" ]; then \
		$(MAKE) build-agents; \
	elif [ "$(TARGET)" = "frontends" ]; then \
		$(MAKE) build-frontends; \
	else \
		echo "$(RED)Specify SERVICE=name or TARGET=all|services|agents|frontends$(NC)"; \
		exit 1; \
	fi

.PHONY: build-single
build-single: ## Build single service (internal use)
	@echo "$(YELLOW)Building $(SERVICE)...$(NC)"
	@if [ -f "build/docker/backend/$(SERVICE).dockerfile" ]; then \
		docker build -t $(REGISTRY)/$(SERVICE):$(IMAGE_TAG) \
			-f build/docker/backend/$(SERVICE).dockerfile .; \
	elif [ -f "build/docker/agents/$(SERVICE).dockerfile" ]; then \
		docker build -t $(REGISTRY)/$(SERVICE):$(IMAGE_TAG) \
			-f build/docker/agents/$(SERVICE).dockerfile .; \
	elif [ -d "frontends/$(SERVICE)" ]; then \
		cd frontends/$(SERVICE) && npm install && npm run build && \
		docker build -t $(REGISTRY)/$(SERVICE):$(IMAGE_TAG) -f Dockerfile .; \
	else \
		echo "$(RED)No dockerfile found for $(SERVICE)$(NC)"; \
		exit 1; \
	fi

.PHONY: build-services
build-services: ## Build all core services
	@for service in auth-service core-manager; do \
		$(MAKE) build-single SERVICE=$$service; \
	done

.PHONY: build-agents
build-agents: ## Build all agents
	@for agent in agent-chassis reasoning-agent web-search-adapter image-generator-adapter \
	             content-creator-agent domain-analyst site-architect content-researcher \
	             html-developer visual-designer site-publisher website-builder; do \
		$(MAKE) build-single SERVICE=$$agent; \
	done

.PHONY: build-frontends
build-frontends: ## Build all frontends
	@for frontend in admin-dashboard user-portal agent-playground; do \
		$(MAKE) build-single SERVICE=$$frontend; \
	done

.PHONY: push
push: ## Push images (SERVICE=name or TARGET=all)
	@if [ -n "$(SERVICE)" ]; then \
		docker push $(REGISTRY)/$(SERVICE):$(IMAGE_TAG); \
	elif [ "$(TARGET)" = "all" ]; then \
		$(MAKE) push-services push-agents push-frontends; \
	else \
		echo "$(RED)Specify SERVICE=name or TARGET=all$(NC)"; \
		exit 1; \
	fi

.PHONY: push-services
push-services: ## Push all services
	@for service in auth-service core-manager; do \
		docker push $(REGISTRY)/$$service:$(IMAGE_TAG); \
	done

.PHONY: push-agents
push-agents: ## Push all agents
	@for agent in agent-chassis reasoning-agent web-search-adapter image-generator-adapter \
	             content-creator-agent domain-analyst site-architect content-researcher \
	             html-developer visual-designer site-publisher website-builder; do \
		docker push $(REGISTRY)/$$agent:$(IMAGE_TAG); \
	done

.PHONY: push-frontends
push-frontends: ## Push all frontends
	@for frontend in admin-dashboard user-portal agent-playground; do \
		docker push $(REGISTRY)/$$frontend:$(IMAGE_TAG); \
	done

#################################
# APPLICATION DEPLOYMENT
#################################
.PHONY: deploy-apps
deploy-apps: update-image-tags ## Deploy all applications
	@echo "$(YELLOW)Deploying applications...$(NC)"
	@$(MAKE) deploy TARGET=services
	@$(MAKE) deploy TARGET=agents
	@$(MAKE) deploy TARGET=frontends
	@echo "$(GREEN)Application deployment complete$(NC)"

.PHONY: deploy
deploy: ## Deploy (SERVICE=name or TARGET=services|agents|frontends)
	@if [ -n "$(SERVICE)" ]; then \
		$(MAKE) deploy-single SERVICE=$(SERVICE); \
	elif [ "$(TARGET)" = "services" ]; then \
		$(MAKE) deploy-services; \
	elif [ "$(TARGET)" = "agents" ]; then \
		$(MAKE) deploy-agents; \
	elif [ "$(TARGET)" = "frontends" ]; then \
		$(MAKE) deploy-frontends; \
	else \
		echo "$(RED)Specify SERVICE=name or TARGET=services|agents|frontends$(NC)"; \
		exit 1; \
	fi

.PHONY: deploy-single
deploy-single: ## Deploy single service
	@echo "$(YELLOW)Deploying $(SERVICE)...$(NC)"
	@if [ -d "$(KUSTOMIZE_DIR)/services/$(SERVICE)/overlays/$(OVERLAY_PATH)" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl apply -k $(KUSTOMIZE_DIR)/services/$(SERVICE)/overlays/$(OVERLAY_PATH); \
	elif [ -d "$(KUSTOMIZE_DIR)/agents/$(SERVICE)/overlays/$(OVERLAY_PATH)" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl apply -k $(KUSTOMIZE_DIR)/agents/$(SERVICE)/overlays/$(OVERLAY_PATH); \
	elif [ -d "$(KUSTOMIZE_DIR)/frontends/$(SERVICE)/overlays/$(OVERLAY_PATH)" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl apply -k $(KUSTOMIZE_DIR)/frontends/$(SERVICE)/overlays/$(OVERLAY_PATH); \
	else \
		echo "$(YELLOW)$(SERVICE) will be spawned dynamically$(NC)"; \
	fi

.PHONY: deploy-services
deploy-services: ## Deploy core services
	@for service in auth-service core-manager; do \
		$(MAKE) deploy-single SERVICE=$$service; \
	done

.PHONY: deploy-agents
deploy-agents: ## Deploy all agents
	@for agent in agent-chassis reasoning-agent web-search-adapter image-generator-adapter content-creator-agent; do \
		$(MAKE) deploy-single SERVICE=$$agent; \
	done

.PHONY: deploy-frontends
deploy-frontends: ## Deploy all frontends
	@for frontend in admin-dashboard user-portal agent-playground; do \
		$(MAKE) deploy-single SERVICE=$$frontend; \
	done

#################################
# SERVICE OPERATIONS (Parameterized)
#################################
.PHONY: restart
restart: ## Restart deployment (SERVICE=name or TARGET=all)
	@if [ -n "$(SERVICE)" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl rollout restart deployment/$(SERVICE) -n $(PROJECT_NAME) 2>/dev/null || \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl rollout restart statefulset/$(SERVICE) -n $(PROJECT_NAME) 2>/dev/null || \
		echo "$(RED)$(SERVICE) not found$(NC)"; \
	elif [ "$(TARGET)" = "all" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl rollout restart deployment -n $(PROJECT_NAME); \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl rollout restart statefulset -n $(PROJECT_NAME); \
	else \
		echo "$(RED)Specify SERVICE=name or TARGET=all$(NC)"; \
	fi

.PHONY: rollback
rollback: ## Rollback deployment (SERVICE=name)
	@if [ -z "$(SERVICE)" ]; then \
		echo "$(RED)SERVICE required. Usage: make rollback SERVICE=auth-service$(NC)"; \
		exit 1; \
	fi
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl rollout undo deployment/$(SERVICE) -n $(PROJECT_NAME)

.PHONY: logs
logs: ## View logs (SERVICE=name or TARGET=all)
	@if [ -n "$(SERVICE)" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl logs -f -n $(PROJECT_NAME) -l app=$(SERVICE) --all-containers=true; \
	elif [ "$(TARGET)" = "all" ]; then \
		KUBECONFIG=$(KUBECONFIG_PATH) kubectl logs -f -n $(PROJECT_NAME) --all-containers=true --tail=50; \
	else \
		echo "$(RED)Specify SERVICE=name or TARGET=all$(NC)"; \
	fi

.PHONY: port-forward
port-forward: ## Port forward service (SERVICE=name PORT=local:remote)
	@if [ -z "$(SERVICE)" ] || [ -z "$(PORT)" ]; then \
		echo "$(RED)Usage: make port-forward SERVICE=grafana PORT=3001:3000$(NC)"; \
		exit 1; \
	fi
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl port-forward -n $(PROJECT_NAME) svc/$(SERVICE) $(PORT)

#################################
# DATABASE OPERATIONS
#################################
.PHONY: db-console
db-console: ## Open database console (DB=clients|templates|auth)
	@if [ -z "$(DB)" ]; then \
		echo "$(RED)DB required. Options: clients, templates, auth$(NC)"; \
		exit 1; \
	fi
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl exec -it postgres-$(DB)-0 -n $(PROJECT_NAME) -- \
		psql -U $(DB)_user -d $(DB)_db

.PHONY: db-query
db-query: ## Execute SQL query (DB=clients SQL="SELECT...")
	@if [ -z "$(DB)" ] || [ -z "$(SQL)" ]; then \
		echo "$(RED)Usage: make db-query DB=clients SQL=\"SELECT * FROM table\"$(NC)"; \
		exit 1; \
	fi
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl exec -it postgres-$(DB)-0 -n $(PROJECT_NAME) -- \
		psql -U $(DB)_user -d $(DB)_db -c "$(SQL)"

.PHONY: db-migrate
db-migrate: ## Run database migrations
	@echo "$(YELLOW)Running database migrations...$(NC)"
	@$(MAKE) deploy-infra-step STEP=070-database-schemas

.PHONY: db-seed
db-seed: ## Seed database with test data
	@echo "$(YELLOW)Seeding database...$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl exec -it postgres-clients-0 -n $(PROJECT_NAME) -- \
		psql -U clients_user -d clients_db -f /scripts/seed-data.sql

#################################
# DEVELOPMENT
#################################
.PHONY: dev
dev: ## Start local development environment
	@echo "$(YELLOW)Starting local development environment...$(NC)"
	@docker-compose -f deployments/docker-compose/docker-compose.yaml up -d

.PHONY: dev-stop
dev-stop: ## Stop local development environment
	@docker-compose -f deployments/docker-compose/docker-compose.yaml down

.PHONY: dev-clean
dev-clean: ## Clean local development environment
	@docker-compose -f deployments/docker-compose/docker-compose.yaml down -v

.PHONY: test
test: ## Run tests (TYPE=unit|integration|e2e)
	@if [ "$(TYPE)" = "unit" ] || [ -z "$(TYPE)" ]; then \
		echo "$(YELLOW)Running unit tests...$(NC)"; \
		go test ./... -v -short; \
	elif [ "$(TYPE)" = "integration" ]; then \
		echo "$(YELLOW)Running integration tests...$(NC)"; \
		go test ./tests/integration/... -v; \
	elif [ "$(TYPE)" = "e2e" ]; then \
		echo "$(YELLOW)Running E2E tests...$(NC)"; \
		go test ./tests/e2e/... -v; \
	fi

#################################
# MONITORING & TROUBLESHOOTING
#################################
.PHONY: monitor
monitor: ## Monitor system (TYPE=workflows|agents|metrics)
	@if [ "$(TYPE)" = "workflows" ] || [ -z "$(TYPE)" ]; then \
		$(MAKE) monitor-workflows; \
	elif [ "$(TYPE)" = "agents" ]; then \
		$(MAKE) monitor-agents; \
	elif [ "$(TYPE)" = "metrics" ]; then \
		$(MAKE) monitor-metrics; \
	fi

.PHONY: monitor-workflows
monitor-workflows: ## Monitor workflow status
	@echo "$(YELLOW)Active Workflows:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl exec -it postgres-clients-0 -n $(PROJECT_NAME) -- psql -U clients_user -d clients_db -c \
		"SELECT correlation_id, current_step, status, \
		 ROUND(EXTRACT(EPOCH FROM (NOW() - updated_at))/60) as minutes_ago \
		 FROM orchestrator_state \
		 WHERE status IN ('RUNNING', 'AWAITING_RESPONSES') \
		 ORDER BY updated_at DESC LIMIT 10;"

.PHONY: monitor-agents
monitor-agents: ## Monitor agent jobs
	@echo "$(YELLOW)Running Agent Jobs:$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get jobs -n $(PROJECT_NAME) -l spawned-by=orchestrator

.PHONY: monitor-metrics
monitor-metrics: ## Show system metrics
	@echo "$(YELLOW)System Metrics (24h):$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl exec -it postgres-clients-0 -n $(PROJECT_NAME) -- psql -U clients_user -d clients_db -c \
		"SELECT COUNT(*) as total_workflows, \
		 COUNT(CASE WHEN status = 'COMPLETED' THEN 1 END) as completed, \
		 COUNT(CASE WHEN status = 'FAILED' THEN 1 END) as failed, \
		 ROUND(100.0 * COUNT(CASE WHEN status = 'COMPLETED' THEN 1 END) / NULLIF(COUNT(*), 0), 1) as success_rate \
		 FROM orchestrator_state WHERE created_at > NOW() - INTERVAL '24 hours';"

.PHONY: cleanup-jobs
cleanup-jobs: ## Clean up completed Kubernetes jobs
	@echo "$(YELLOW)Cleaning up completed jobs...$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl delete jobs -n $(PROJECT_NAME) --field-selector status.successful=1

#################################
# IMAGE TAG MANAGEMENT
#################################
.PHONY: update-image-tags
update-image-tags: ## Update image tags everywhere (TAG=v1.0.49)
	@if [ -z "$(TAG)" ]; then \
		TAG=$(IMAGE_TAG); \
	fi; \
	echo "$(YELLOW)Updating all image tags to $$TAG...$(NC)"; \
	$(MAKE) update-kustomization-tags TAG=$$TAG; \
	$(MAKE) update-configmap-tags TAG=$$TAG; \
	$(MAKE) update-db-tags TAG=$$TAG

.PHONY: update-kustomization-tags
update-kustomization-tags: ## Update kustomization files
	@find $(KUSTOMIZE_DIR) -name "kustomization.yaml" -path "*/overlays/$(OVERLAY_PATH)/*" | while read file; do \
		sed -i.bak 's/newTag:.*/newTag: $(TAG)/' "$$file"; \
	done

.PHONY: update-configmap-tags
update-configmap-tags: ## Update ConfigMap tags
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl patch configmap personae-prod-config \
		-n $(PROJECT_NAME) \
		--type merge \
		-p '{"data":{"AGENT_IMAGE_TAG":"$(TAG)"}}'

.PHONY: update-db-tags
update-db-tags: ## Update database agent definitions
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl exec -it postgres-templates-0 -n $(PROJECT_NAME) -- \
		psql -U templates_user -d templates_db -c \
		"UPDATE agent_definitions SET image_tag = '$(TAG)', updated_at = NOW() WHERE image_repository LIKE '$(REGISTRY)%';"

.PHONY: verify-tags
verify-tags: ## Verify image tags are consistent
	@echo "$(YELLOW)Image Tag Verification:$(NC)"
	@echo "ConfigMap: $$(KUBECONFIG=$(KUBECONFIG_PATH) kubectl get configmap personae-prod-config -n $(PROJECT_NAME) -o jsonpath='{.data.AGENT_IMAGE_TAG}')"
	@echo "Deployments:"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get deployments -n $(PROJECT_NAME) -o custom-columns=NAME:.metadata.name,IMAGE:.spec.template.spec.containers[0].image | head -5

#################################
# KIND CLUSTER (Development)
#################################
.PHONY: kind-create
kind-create: ## Create Kind development cluster
	@echo "$(YELLOW)Creating Kind cluster...$(NC)"
	@cd deployments/terraform/environments/development/uk_dev/010-infrastructure && \
		terraform init && terraform apply -auto-approve

.PHONY: kind-delete
kind-delete: ## Delete Kind cluster
	@echo "$(RED)Deleting Kind cluster...$(NC)"
	@cd deployments/terraform/environments/development/uk_dev/010-infrastructure && \
		terraform destroy -auto-approve

.PHONY: kind-load
kind-load: ## Load images into Kind (SERVICE=name or TARGET=all)
	@mkdir -p $(TMPDIR)
	@if [ -n "$(SERVICE)" ]; then \
		kind load docker-image $(REGISTRY)/$(SERVICE):$(IMAGE_TAG) --name personae-dev; \
	elif [ "$(TARGET)" = "all" ]; then \
		for img in auth-service core-manager agent-chassis reasoning-agent web-search-adapter \
		          image-generator-adapter content-creator-agent; do \
			kind load docker-image $(REGISTRY)/$$img:$(IMAGE_TAG) --name personae-dev; \
		done; \
	fi

#################################
# DOCUMENTATION
#################################
.PHONY: docs
docs: ## Generate and serve documentation
	@echo "$(YELLOW)Generating documentation...$(NC)"
	@if command -v swag > /dev/null; then \
		cd cmd/auth-service && swag init -g main.go -o docs; \
		cd ../core-manager && swag init -g main.go -o docs; \
	else \
		echo "$(YELLOW)Install swag first: go install github.com/swaggo/swag/cmd/swag@latest$(NC)"; \
	fi

.PHONY: docs-serve
docs-serve: ## Serve documentation locally
	@docker-compose -f deployments/docker-compose/docker-compose.swagger.yml up -d
	@echo "$(GREEN)Documentation available at:$(NC)"
	@echo "  • Swagger UI: http://localhost:8082"
	@echo "  • Redoc: http://localhost:8083"

#################################
# AGENT MANAGEMENT
#################################
.PHONY: agent-list
agent-list: ## List all agent definitions
	@$(MAKE) db-query DB=templates SQL="SELECT type, display_name, category, is_active FROM agent_definitions ORDER BY type"

.PHONY: agent-spawn
agent-spawn: ## Spawn an agent (TYPE=analyzer CLIENT=demo_client)
	@if [ -z "$(TYPE)" ] || [ -z "$(CLIENT)" ]; then \
		echo "$(RED)Usage: make agent-spawn TYPE=analyzer CLIENT=demo_client$(NC)"; \
		exit 1; \
	fi
	@echo "$(YELLOW)Spawning agent $(TYPE) for $(CLIENT)...$(NC)"
	@curl -X POST http://localhost:8088/api/v1/agents/spawn \
		-H "Content-Type: application/json" \
		-d '{"agent_type": "$(TYPE)", "client_id": "$(CLIENT)"}'

.PHONY: agent-performance
agent-performance: ## Show agent performance metrics
	@$(MAKE) db-query DB=templates SQL="SELECT agent_type, total_tasks, ROUND(success_rate*100,1)||'%' as success_rate, avg_response_time_ms||'ms' as avg_time FROM agent_metrics WHERE total_tasks > 0 ORDER BY success_rate DESC"

#################################
# SECRETS MANAGEMENT
#################################
.PHONY: create-secrets
create-secrets: ## Create all required secrets
	@echo "$(YELLOW)Creating secrets...$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl create namespace $(PROJECT_NAME) --dry-run=client -o yaml | kubectl apply -f -
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl create secret generic personae-dev-secrets \
		--from-env-file=.env \
		-n $(PROJECT_NAME) --dry-run=client -o yaml | kubectl apply -f -
	@echo "$(GREEN)Secrets created$(NC)"

.PHONY: verify-secrets
verify-secrets: ## Verify secrets exist
	@echo "$(YELLOW)Verifying secrets...$(NC)"
	@KUBECONFIG=$(KUBECONFIG_PATH) kubectl get secrets -n $(PROJECT_NAME) --field-selector type=Opaque


.PHONY: import-cluster
import-cluster: ## Import existing cluster into Terraform state
	@echo "$(YELLOW)Importing existing cluster...$(NC)"
	@cd $(TERRAFORM_DIR)/010-infrastructure && \
		terraform import module.kubernetes_cluster.spot_cloudspace.cluster uk001-prod-agent-chassis-cluster

.PHONY: deploy-infra-smart
deploy-infra-smart: ## Deploy infrastructure (checks for existing cluster)
	@if spot cloudspace get uk001-prod-agent-chassis-cluster 2>/dev/null; then \
		echo "$(GREEN)Cluster exists, continuing from ingress...$(NC)"; \
		$(MAKE) deploy-infra-from-ingress; \
	else \
		echo "$(YELLOW)Creating new cluster...$(NC)"; \
		$(MAKE) deploy-infra; \
	fi


.PHONY: deploy-infra-from
deploy-infra-from: ## Deploy infrastructure from specific step (FROM=047-base-configs)
	@if [ -z "$(FROM)" ]; then \
		echo "$(RED)Specify starting point: make deploy-infra-from FROM=047-base-configs$(NC)"; \
		exit 1; \
	fi
	@echo "$(YELLOW)Deploying infrastructure from $(FROM) onwards...$(NC)"
	@STEPS="010-infrastructure 020-ingress-nginx 030-strimzi-operator 040-kafka-cluster \
	        045-kafka-users 047-base-configs 050-storage 060-databases \
	        070-database-schemas 080-kafka-topics 090-monitoring 100-bootstrap-agents"; \
	FOUND=0; \
	for step in $$STEPS; do \
		if [ "$$step" = "$(FROM)" ]; then FOUND=1; fi; \
		if [ $$FOUND -eq 1 ]; then \
			echo "$(GREEN)Deploying $$step...$(NC)"; \
			$(MAKE) deploy-infra-step STEP=$$step || exit 1; \
		fi; \
	done
	@echo "$(GREEN)Infrastructure deployment complete!$(NC)"

