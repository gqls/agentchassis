{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/scratch-git-snapshot.py\" 2>/dev/null || true",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/commit-advisory-postuse.py\" 2>/dev/null || true",
            "timeout": 25
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/landmines-session-start.py\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Checking landmines for files in flight"
          }
        ]
      }
    ]
  }
}
