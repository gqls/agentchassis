#!/usr/bin/env bash
# Shared hooks live here (tracked). Enable once per clone:
#   git config core.hooksPath .githooks
#
# Order matters, and so does which of these can block:
#   1. check-secrets.sh   — a REAL GATE. Its non-zero exit must still stop the
#                           commit; that is the whole point of it.
#   2. commit-scope-report.sh — ADVISORY ONLY. Prints what the commit actually
#                           contains so a file belonging to another session is
#                           visible before it lands. It must NEVER block, so it
#                           is wrapped to swallow any failure.
#   3. pattern-check.py   — ADVISORY ONLY. Runs the mechanically checkable
#                           subset of 016b section 9 against the staged diff
#                           (untouched twin, gofmt, stdin-eating read loop,
#                           declared co-change pairs). Measured at a 2% fire
#                           rate over 150 commits before being wired in here.
#                           Same rule: it must NEVER block, so it is wrapped.
#   4. check-optional-key-parity.sh — ADVISORY ONLY, and SCOPED: it runs RFC_022's
#                           parity guard only when the staged diff touches the
#                           budget cron's literal, the acks file, or a Go file
#                           declaring an ActionInputSpec. Wired in 2026-08-18 after
#                           that guard was found failing at HEAD for days, because
#                           it lives in a package no ordinary change touches.
# This file runs for every session on every commit — a stray non-zero exit here
# stops the whole fleet committing. Keep it boring.
ROOT="$(git rev-parse --show-toplevel)"

"$ROOT/scripts/check-secrets.sh" || exit $?

if [ -x "$ROOT/scripts/commit-scope-report.sh" ]; then
  "$ROOT/scripts/commit-scope-report.sh" || true
fi

if [ -x "$ROOT/scripts/pattern-check.py" ]; then
  "$ROOT/scripts/pattern-check.py" || true
fi

if [ -x "$ROOT/scripts/check-optional-key-parity.sh" ]; then
  "$ROOT/scripts/check-optional-key-parity.sh" || true
fi

exit 0
