#!/usr/bin/env bash
# commit-msg — three checks, in order:
#   (1) D2 direction-document gate — a REAL GATE (owner ruling 2026-07-20): blocks
#       a commit touching a blessed direction doc without a `Direction-Approved:`
#       trailer. UNCHANGED from the original; its exit 1 must still block.
#   (1b) trailer-shape gate — a REAL GATE (2026-08-03): blocks a Council-Submitted:/
#       Council-Reviewed: trailer whose value cannot be a correlation id. This does
#       NOT enforce review (that stays advisory per the 2026-07-24 ruling) — it
#       refuses a false-shaped claim, the 098 report's stated dishonesty surface.
#   (2) council coverage nudge — ADVISORY (owner ruling 2026-07-24, "strengthen
#       advisory, defer structural"): a short note on an un-reviewed platform-code
#       commit. Delegated to scripts/council-coverage-nudge.sh and wrapped so it
#       can NEVER block.
#
# Order matters: the gate runs first (a blocked commit needs no nudge); the nudge
# runs for the commits the gate waves through (the vast majority). EVERY path other
# than "blessed direction doc without trailer" reaches the nudge and exits 0 — the
# gate's early returns became fall-throughs so the nudge can run on normal commits.
# No `set -e`: a stray non-zero must never abort a commit here.

MSG_FILE="$1"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT="."

# ── (1) Direction gate (BLOCKING) ─────────────────────────────────────────────
# Blessed paths (keep in lockstep with DIRECTION_LEDGER.md).
BLESSED='docs/agent_docs/docs024_key_docs_latest/adoption/docubundle/thin_slice_constitution.md
scripts/documentation_project/02/thin_slice_constitution.md
docs/agent_docs/docs019_documentation_audit_autonomous_build_and_operate/go_files/contextkit/thin_slice_constitution.md
docs/agent_docs/docs024_key_docs_latest/028_platform_mission_and_pipeline_direction(2).md
docs/agent_docs/docs014_documentation_collection/028_platform_mission_and_pipeline_direction(2).md
docs/agent_docs/docs026_concept_register/DIRECTION_LEDGER.md'

STAGED=$(git diff --cached --name-only 2>/dev/null || true)
TOUCHED=""
if [ -n "$STAGED" ]; then
  while IFS= read -r f; do
    while IFS= read -r b; do
      [ "$f" = "$b" ] && TOUCHED="${TOUCHED}  ${f}\n"
    done <<EOF2
$BLESSED
EOF2
  done <<EOF1
$STAGED
EOF1
fi

if [ -n "$TOUCHED" ] && ! grep -qi '^Direction-Approved:' "$MSG_FILE"; then
  printf '\033[1;31m── DIRECTION GATE: commit blocked ──\033[0m\n'
  printf 'This commit touches blessed direction document(s):\n'
  printf "$TOUCHED"
  printf 'The constitution and mission are the platform'"'"'s FIXED direction (owner\n'
  printf 'ruling 2026-07-20). Editing them requires the owner'"'"'s explicit word for\n'
  printf 'THIS change, recorded as a commit-message trailer:\n\n'
  printf '    Direction-Approved: <who gave the word>\n\n'
  printf 'Also update the sha256 in docs/agent_docs/docs026_concept_register/DIRECTION_LEDGER.md\n'
  printf 'in the same commit. Do NOT add the trailer without the owner'"'"'s word —\n'
  printf 'that defeats the guard and leaves a false record.\n'
  exit 1
fi

# ── (1b) Trailer-shape gate (BLOCKING) ────────────────────────────────────────
# Three sessions wrote `Council-Submitted: pending` on 2026-08-03 alone; forward-
# only (no amends) makes each one a permanent join key that resolves to nothing.
# The value must look like a correlation id — a UUID or an 8+-char hex prefix of
# one (same shape the coverage nudge parses). An absent trailer is always allowed:
# review itself is not enforced here, only honesty of what the message asserts.
for trailer_name in Council-Submitted Council-Reviewed; do
  trailer_value=$(grep -iE "^[[:space:]]*${trailer_name}:" "$MSG_FILE" \
                    | head -1 | sed -E "s/^[[:space:]]*${trailer_name}:[[:space:]]*//I")
  [ -n "$trailer_value" ] || continue
  if ! printf '%s' "$trailer_value" | grep -qE '^[0-9a-fA-F-]{8,}$'; then
    printf '\033[1;31m── TRAILER GATE: commit blocked ──\033[0m\n'
    printf '    %s: %s\n' "$trailer_name" "$trailer_value"
    printf 'This trailer is a JOIN KEY for the 098 coverage report. A value that is\n'
    printf 'not a UUID (or an 8+-char hex prefix of one) resolves to nothing, and\n'
    printf 'forward-only forbids fixing it with an amend. Either submit first —\n'
    printf '097_TRIGGER_council_review_v1.sh prints SUBMISSION_CORR in seconds —\n'
    printf 'and commit with that id, or drop the trailer entirely: committing\n'
    printf 'before the SUBMISSION exists needs no trailer at all.\n'
    exit 1
  fi
done

# ── (2) Council coverage nudge (ADVISORY — never blocks) ───────────────────────
if [ -x "$ROOT/scripts/council-coverage-nudge.sh" ]; then
  "$ROOT/scripts/council-coverage-nudge.sh" "$MSG_FILE" || true
fi
exit 0
