# Debug stage
FROM golang:1.24 AS debug
RUN go install github.com/go-delve/delve/cmd/dlv@latest
WORKDIR /app
COPY . .
RUN go build -gcflags="all=-N -l" -o agent-chassis ./cmd/agent-chassis
EXPOSE 40000
CMD ["dlv", "--listen=:40000", "--headless=true", "--api-version=2", "--accept-multiclient", "exec", "./agent-chassis"]