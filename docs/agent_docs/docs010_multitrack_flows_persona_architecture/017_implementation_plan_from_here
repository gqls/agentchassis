### Step 3C: Component Assembly Action (Week 8)

**New action: `assemble_from_components`**

```go
// Action: assemble_from_components
// Selects and assembles components based on page requirements
func AssembleFromComponents(ctx ActionContext) error {
    pageType := ctx.Config["page_type"] // "landing", "home", "services"
    requirements := ctx.InputData["requirements"]

    // 1. Query relevant components
    components := queryComponents(pageType, requirements)

    // 2. Build component tree
    tree := buildComponentTree(components, requirements)

    // 3. Render with data
    html := renderComponentTree(tree, requirements.Data)

    // 4. Collect CSS/JS dependencies
    assets := collectDependencies(tree)

    ctx.Output = map[string]interface{}{
        "html": html,
        "css": assets.CSS,
        "js": assets.JS,
    }

    return nil
}

func queryComponents(pageType string, requirements Requirements) []Component {
    // Simple SQL query
    query := `
        SELECT * FROM content_components
        WHERE usage_context->>'page_types' ? $1
        ORDER BY usage_count DESC
    `

    return db.Query(query, pageType)
}

func buildComponentTree(components []Component, requirements Requirements) ComponentTree {
    // Start with page archetype
    switch requirements.Archetype {
    case "landing":
        return ComponentTree{
            Root: "hero_modern",
            Children: {
                "slot_cta": "cta_button_primary",
            },
            Next: "feature_grid_3col",
        }
    case "services":
        return ComponentTree{
            Root: "header_simple",
            Next: "service_details",
        }
    }
}
```

