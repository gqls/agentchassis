        },
        "stage_3": {
            "name": "conversion",
            "voice_formality": 0.7,
            "technical_depth": 0.5,
            "pages": ["contact.html"]
        }
    }
    */

    created_at TIMESTAMP WITH TIME ZONE DEFAULT now()
);

-- Simple function to get voice params for a page
CREATE OR REPLACE FUNCTION get_page_voice_params(
    p_orchestration_id UUID,
    p_page_path TEXT
)
RETURNS JSONB AS $$
DECLARE
    v_flow_config JSONB;
    v_stage_key TEXT;
    v_stage_config JSONB;
BEGIN
    -- Get flow config
    SELECT flow_config INTO v_flow_config
    FROM site_flows
    WHERE orchestration_id = p_orchestration_id;

    -- Find which stage this page belongs to
    FOR v_stage_key IN SELECT jsonb_object_keys(v_flow_config)
    LOOP
        v_stage_config := v_flow_config->v_stage_key;

        IF v_stage_config->'pages' ? p_page_path THEN
            RETURN v_stage_config;
        END IF;
    END LOOP;

    -- Default if not found
    RETURN '{"voice_formality": 0.7, "technical_depth": 0.5}'::jsonb;
END;
$$ LANGUAGE plpgsql;
```

