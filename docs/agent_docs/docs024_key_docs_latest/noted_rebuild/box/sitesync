#!/usr/bin/env bash
# /usr/local/bin/sitesync — pull this box's built sites from gqls/vm-sites into
# their web roots. Idempotent; safe to run by hand. Run every 5 minutes by
# sitesync.timer as www-data. Adapted from idea.uk's (same repo, different
# domain folder) — see idea_uk_vm_site/box/sitesync for the original.
#
# reset --hard to origin, never merge: the repo is the single source of truth
# and the box must not accumulate local drift.
#
# 2026-08-11: generalised from one hardcoded domain to a LIST, because this box
# now serves noted.co.uk alongside webdesign.uk. ~~The loop is the whole change —~~
# adding a third domain is one line, and no domain can be added by editing the
# rsync of another and getting its --delete target wrong.
#
# 2026-08-12 CORRECTION: the loop was NOT the whole change. This clone is a
# `--filter=blob:none --sparse` partial clone, and its sparse cone is set ONCE at
# provisioning (webdesign_uk_build_service/box/setup-webdesignbox.sh:70,
# `git sparse-checkout set webdesign.uk`). So noted.co.uk sat in DOMAINS for a day
# while the cone still held only webdesign.uk: the folder never materialised, the
# guard below skipped it, and this unit exited 0/SUCCESS every 5 minutes having
# delivered nothing. Two lists that had to agree, in two files, one of which never
# runs again.
#
# The fix is structural: the cone is now DERIVED from DOMAINS on every run, so the
# two cannot disagree. Adding a domain really is one line now. The guards also warn
# instead of skipping in silence — a skip is a legitimate state, but an invisible
# one is indistinguishable from working.
set -euo pipefail

# Each entry is "<repo folder>:<web root>". Both sites are pull-model: nothing
# is pushed to this box and it holds no cluster credential.
DOMAINS=(
  "webdesign.uk:/var/www/webdesign.uk"
  "noted.co.uk:/var/www/noted.co.uk"
)

# ssh expands `~` from the passwd entry (getpwuid), NOT $HOME — www-data's passwd
# home is /var/www, so setting HOME in the unit is not enough. Name the identity
# and known_hosts explicitly. See agentchassis bugs_open/016.
export GIT_SSH_COMMAND="ssh -i /var/lib/sitesync/.ssh/id_ed25519 -o IdentitiesOnly=yes \
-o UserKnownHostsFile=/var/lib/sitesync/.ssh/known_hosts -o StrictHostKeyChecking=yes"

cd /var/lib/sitesync/repo
git fetch --quiet origin main

# Reconcile the sparse cone with DOMAINS before checking anything out. Compared
# rather than set unconditionally, because `sparse-checkout set` re-runs a
# checkout in the clone that also feeds the LIVE webdesign.uk shopfront, and doing
# that every 5 minutes for no reason is how a rare failure gets 288 chances a day.
folders=()
for entry in "${DOMAINS[@]}"; do folders+=("${entry%%:*}"); done

want="$(printf '%s\n' "${folders[@]}" | LC_ALL=C sort)"
have="$(git sparse-checkout list 2>/dev/null | LC_ALL=C sort || true)"
if [ "$want" != "$have" ]; then
  echo "sitesync: sparse cone differs from DOMAINS — setting to: ${folders[*]}" >&2
  git sparse-checkout set "${folders[@]}"
fi

git reset --hard --quiet origin/main

for entry in "${DOMAINS[@]}"; do
  folder="${entry%%:*}"
  webroot="${entry##*:}"

  # A folder may not exist yet: the box is provisioned before the site's first
  # page deploys. Absent is "nothing to sync", not an error — without this guard,
  # set -e + rsync's exit 23 kills the timer unit and the failure mode is
  # "sync silently stopped weeks ago".
  #
  # These were one combined `if` until 2026-08-12. They are split and made LOUD
  # because the two skips have opposite meanings and the silent version cost a day:
  # a missing folder is now almost certainly a real fault (the cone is derived
  # above, so the folder should exist unless the site has never deployed), whereas
  # a missing web root is a deliberate "not set up on this box".
  if [ ! -d "$folder" ]; then
    echo "sitesync: WARNING: '$folder' is in DOMAINS but absent from the checkout — nothing delivered for it. Has this site ever deployed to the repo?" >&2
    continue
  fi

  # NOTE the second guard: rsync --delete into a web root that does not exist
  # would create it and serve an empty site. If the web root is missing, the
  # site was never set up here and syncing into it is not what anyone meant.
  if [ ! -d "$webroot" ]; then
    echo "sitesync: WARNING: web root '$webroot' missing — '$folder' not set up on this box, skipping" >&2
    continue
  fi

  rsync -a --delete "$folder/" "$webroot/"
done
