[
  {
    "name": "the page stops being served (404)",
    "serve_status": 404,
    "expect_fail": [
      "page-serves-200"
    ]
  },
  {
    "name": "the section loses the identity acceptance resolves it by",
    "from": "data-component=\"faq\"",
    "to": "data-component=\"faq-renamed\"",
    "expect_fail": [
      "section-renders"
    ]
  },
  {
    "name": "the section collapses below visible size (10x10, overflow hidden)",
    "from": "</body>",
    "to": "<style>section.section--faq[data-component=\"faq\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
    "expect_fail": [
      "section-has-visible-area"
    ]
  },
  {
    "name": "the question list vanishes (renders with zero questions)",
    "from": "<div class=\"faq-list\">",
    "to": "<div class=\"faq-list-renamed\">",
    "expect_fail": [
      "at-least-one-question"
    ]
  },
  {
    "name": "the first question stops accepting clicks (pointer-events none)",
    "from": "</body>",
    "to": "<style>details.faq-item summary{pointer-events:none!important}</style></body>",
    "expect_fail": [
      "real-click-opens-first-question"
    ]
  },
  {
    "name": "a wide element pushes the page past the viewport",
    "from": "</body>",
    "to": "<div style=\"width:3000px;height:8px\"></div></body>",
    "expect_fail": [
      "no-horizontal-overflow"
    ]
  },
  {
    "name": "a script error reaches the console",
    "from": "</body>",
    "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
    "expect_fail": [
      "no-console-errors"
    ]
  }
]
