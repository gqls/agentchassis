[
  {
    "name": "the page stops being served (404)",
    "serve_status": 404,
    "expect_fail": [
      "page-serves-200"
    ]
  },
  {
    "name": "the section loses the identity acceptance resolves it by",
    "from": "data-component=\"case-studies-grid\"",
    "to": "data-component=\"case-studies-grid-renamed\"",
    "expect_fail": [
      "section-renders"
    ]
  },
  {
    "name": "the section collapses below visible size (10x10, overflow hidden)",
    "from": "</body>",
    "to": "<style>section.case-studies-grid-section[data-component=\"case-studies-grid\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
    "expect_fail": [
      "section-has-visible-area"
    ]
  },
  {
    "name": "the headline renders empty",
    "from": "<h1 class=\"csg-headline\">What We've Actually Built and Run</h1>",
    "to": "<h1 class=\"csg-headline\"></h1>",
    "expect_fail": [
      "headline-has-text"
    ]
  },
  {
    "name": "the card grid loses its container class, so no card sits inside the grid",
    "from": "class=\"csg-grid\"",
    "to": "class=\"csg-grid-renamed\"",
    "expect_fail": [
      "at-least-one-card"
    ]
  },
  {
    "name": "the component's own script never runs, so clicking a filter does nothing",
    "from": "<script src=\"/tools/assets/case-studies-grid.js\"></script>",
    "to": "<script>/* component script removed by mutant */</script>",
    "expect_fail": [
      "real-click-moves-the-filter"
    ]
  },
  {
    "name": "a wide element pushes the page past the viewport",
    "from": "</body>",
    "to": "<div style=\"width:3000px;height:8px\"></div></body>",
    "expect_fail": [
      "no-horizontal-overflow"
    ]
  },
  {
    "name": "a script error reaches the console",
    "from": "</body>",
    "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
    "expect_fail": [
      "no-console-errors"
    ]
  }
]
