    "to": "data-component=\"hero-tool-renamed\"",
    "expect_fail": [
      "section-renders"
    ]
  },
  {
    "name": "the section collapses below visible size (10x10, overflow hidden)",
    "from": "</body>",
    "to": "<style>section.hero-tool-section[data-component=\"hero-tool\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
    "expect_fail": [
      "section-has-visible-area"
    ]
  },
  {
    "name": "the heading renders empty",
    "from": "<h1 class=\"htl-headline\">Fine-Tuning, RAG, or Prompting Decision Guide</h1>",
    "to": "<h1 class=\"htl-headline\"></h1>",
    "expect_fail": [
      "headline-has-text"
    ]
  },
  {
    "name": "a wide element pushes the page past the viewport",
    "from": "</body>",
    "to": "<div style=\"width:3000px;height:8px\"></div></body>",
    "expect_fail": [
      "no-horizontal-overflow"
    ]
  },
  {
    "name": "a script error reaches the console",
    "from": "</body>",
    "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
