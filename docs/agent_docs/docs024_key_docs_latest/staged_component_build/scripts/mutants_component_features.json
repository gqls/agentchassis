[
  {
    "name": "the page stops being served (404)",
    "serve_status": 404,
    "expect_fail": [
      "page-serves-200"
    ]
  },
  {
    "name": "the section loses the identity acceptance resolves it by",
    "from": "data-component=\"features\"",
    "to": "data-component=\"features-renamed\"",
    "expect_fail": [
      "section-renders"
    ]
  },
  {
    "name": "the section collapses below visible size (10x10, overflow hidden)",
    "from": "</body>",
    "to": "<style>section.features-section[data-component=\"features\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
    "expect_fail": [
      "section-has-visible-area"
    ]
  },
  {
    "name": "the heading renders empty",
    "from": "<h2>What the Misconfiguration Exposed \u2014 and What the Fix Required</h2>",
    "to": "<h2></h2>",
    "expect_fail": [
      "heading-has-text"
    ]
  },
  {
    "name": "the feature grid vanishes (renders with zero items)",
    "from": "<div class=\"features-grid\">",
    "to": "<div class=\"features-grid-renamed\">",
    "expect_fail": [
      "at-least-one-feature-item"
    ]
  },
  {
    "name": "a wide element pushes the page past the viewport",
    "from": "</body>",
    "to": "<div style=\"width:3000px;height:8px\"></div></body>",
    "expect_fail": [
      "no-horizontal-overflow"
    ]
  },
  {
    "name": "a script error reaches the console",
    "from": "</body>",
    "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
    "expect_fail": [
      "no-console-errors"
    ]
  }
]
