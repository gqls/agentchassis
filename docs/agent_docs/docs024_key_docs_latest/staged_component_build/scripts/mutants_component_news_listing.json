{
  "serve_local": [
    "/data/news-archive.json"
  ],
  "mutants": [
    {
      "name": "the page stops being served (404)",
      "serve_status": 404,
      "expect_fail": [
        "page-serves-200"
      ]
    },
    {
      "name": "the section loses the identity acceptance resolves it by",
      "from": "data-component=\"news-listing\"",
      "to": "data-component=\"news-listing-renamed\"",
      "expect_fail": [
        "section-renders"
      ]
    },
    {
      "name": "the section collapses below visible size (10x10, overflow hidden)",
      "from": "</body>",
      "to": "<style>section.news-listing-section[data-component=\"news-listing\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
      "expect_fail": [
        "section-has-visible-area"
      ]
    },
    {
      "name": "the headline renders empty",
      "from": "<h1 class=\"news-listing-title\">Gripper Industry News & Automation Updates</h1>",
      "to": "<h1 class=\"news-listing-title\"></h1>",
      "expect_fail": [
        "heading-has-text"
      ]
    },
    {
      "name": "the items list loses the container class, so no item sits inside the listing",
      "from": "class=\"news-listing-items\"",
      "to": "class=\"news-listing-items-renamed\"",
      "expect_fail": [
        "at-least-one-item"
      ]
    },
    {
      "name": "the component's own script never runs, so the client-side feed load never happens",
      "from": "<script src=\"/tools/assets/news-listing.js\"></script>",
      "to": "<script>/* component script removed by mutant */</script>",
      "expect_fail": [
        "feed-load-fills-the-count"
      ]
    },
    {
      "name": "a wide element pushes the page past the viewport",
      "from": "</body>",
      "to": "<div style=\"width:3000px;height:8px\"></div></body>",
      "expect_fail": [
        "no-horizontal-overflow"
      ]
    },
    {
      "name": "a script error reaches the console",
      "from": "</body>",
      "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
      "expect_fail": [
        "no-console-errors"
      ]
    }
  ]
}
