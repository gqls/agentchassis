{
  "profiles": ["desktop", "mobile"],
  "container": "section.cta-section[data-component=\"call-to-action\"]",
  "checks": [
    {
      "id": "page-serves-200",
      "type": "page_status_ok"
    },
    {
      "id": "cta-section-renders",
      "type": "selector_exists",
      "profiles": ["desktop"],
      "selector": "section.cta-section[data-component=\"call-to-action\"]"
    },
    {
      "id": "cta-section-has-visible-area",
      "type": "has_visible_area",
      "selector": "section.cta-section[data-component=\"call-to-action\"]"
    },
    {
      "id": "headline-has-text",
      "type": "interaction",
      "profiles": ["desktop"],
      "expect": {
        "selector": "section.cta-section[data-component=\"call-to-action\"] h2",
        "text_matches": "\\S"
      }
    },
    {
      "id": "no-horizontal-overflow",
      "type": "no_horizontal_overflow"
    },
    {
      "id": "no-console-errors",
      "type": "no_console_errors"
    }
  ]
}
