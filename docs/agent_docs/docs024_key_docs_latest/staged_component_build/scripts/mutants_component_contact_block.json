[
  {
    "name": "the page stops being served (404)",
    "serve_status": 404,
    "expect_fail": [
      "page-serves-200"
    ]
  },
  {
    "name": "the section loses the identity acceptance resolves it by",
    "from": "data-component=\"contact-block\"",
    "to": "data-component=\"contact-block-renamed\"",
    "expect_fail": [
      "section-renders"
    ]
  },
  {
    "name": "the section collapses below visible size (10x10, overflow hidden)",
    "from": "</body>",
    "to": "<style>section.contact-block-section[data-component=\"contact-block\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
    "expect_fail": [
      "section-has-visible-area"
    ]
  },
  {
    "name": "the heading renders empty",
    "from": "<h2 class=\"cb-heading\">Get a Direct Technical Response</h2>",
    "to": "<h2 class=\"cb-heading\"></h2>",
    "expect_fail": [
      "heading-has-text"
    ]
  },
  {
    "name": "the form loses the class the contract resolves it by",
    "from": "class=\"cb-form\"",
    "to": "class=\"cb-form-renamed\"",
    "expect_fail": [
      "form-present"
    ]
  },
  {
    "name": "the form loses its destination entirely (the original 228 defect)",
    "from": "<form class=\"cb-form\" id=\"cb-contact-form\" action=\"mailto:robot-hands@contactforsales.com?subject=robot-hands.com enquiry\" method=\"POST\" novalidate",
    "to": "<form class=\"cb-form\" id=\"cb-contact-form\" novalidate",
    "expect_fail": [
      "form-has-a-real-destination"
    ]
  },
  {
    "name": "the form keeps the attribute but it is empty (the pre-class-fix state)",
    "from": "<form class=\"cb-form\" id=\"cb-contact-form\" action=\"mailto:robot-hands@contactforsales.com?subject=robot-hands.com enquiry\" method=\"POST\" novalidate",
    "to": "<form class=\"cb-form\" id=\"cb-contact-form\" action=\"\" method=\"POST\" novalidate",
    "expect_fail": [
      "form-has-a-real-destination"
    ]
  },
  {
    "name": "the component's own script never runs, so an invalid submission gets no reason back",
    "from": "<script src=\"/tools/assets/contact-block.js\"></script>",
    "to": "<script>/* component script removed by mutant */</script>",
    "expect_fail": [
      "empty-submission-is-rejected-with-a-reason"
    ]
  },
  {
    "name": "a wide element pushes the page past the viewport",
    "from": "</body>",
    "to": "<div style=\"width:3000px;height:8px\"></div></body>",
    "expect_fail": [
      "no-horizontal-overflow"
    ]
  },
  {
    "name": "a script error reaches the console",
    "from": "</body>",
    "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
    "expect_fail": [
      "no-console-errors"
    ]
  }
]
