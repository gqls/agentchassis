{
  "serve_local": [
    "/data/model-directory-full.json"
  ],
  "mutants": [
    {
      "name": "the page stops being served (404)",
      "serve_status": 404,
      "expect_fail": [
        "page-serves-200"
      ]
    },
    {
      "name": "the section loses the identity acceptance resolves it by",
      "from": "data-component=\"model-directory-listing\"",
      "to": "data-component=\"model-directory-listing-renamed\"",
      "expect_fail": [
        "section-renders"
      ]
    },
    {
      "name": "the section collapses below visible size (10x10, overflow hidden)",
      "from": "</body>",
      "to": "<style>section.model-directory-listing-section[data-component=\"model-directory-listing\"]{width:10px!important;height:10px!important;overflow:hidden!important;padding:0!important}</style></body>",
      "expect_fail": [
        "section-has-visible-area"
      ]
    },
    {
      "name": "the card container loses the id BOTH the contract and the re-render bind to (the JS null-guards, so this is a clean miss, not a console error)",
      "from": "id=\"model-directory-full-container\"",
      "to": "id=\"model-directory-full-container-renamed\"",
      "expect_fail": [
        "at-least-one-model-card"
      ]
    },
    {
      "name": "the component's script stops being delivered",
      "from": "<script src=\"/tools/assets/model-directory-listing.js\"></script>",
      "to": "<script>/* component script removed by mutant */</script>",
      "expect_fail": [
        "script-is-delivered"
      ]
    },
    {
      "name": "a wide element pushes the page past the viewport",
      "from": "</body>",
      "to": "<div style=\"width:3000px;height:8px\"></div></body>",
      "expect_fail": [
        "no-horizontal-overflow"
      ]
    },
    {
      "name": "a script error reaches the console",
      "from": "</body>",
      "to": "<script>window.__deliberatelyUndefined.boom = 1;</script></body>",
      "expect_fail": [
        "no-console-errors"
      ]
    }
  ]
}
