#!/usr/bin/env bash
# /usr/local/bin/sitesync — pull idea.uk's built site from gqls/vm-sites into
# the web root. Idempotent; safe to run by hand. Installed by provision-pullsync.sh,
# run every 5 minutes by sitesync.timer as www-data.
#
# reset --hard to origin, never merge: the repo is the single source of truth
# and the box must not accumulate local drift.
set -euo pipefail

# ssh expands `~` from the passwd entry (getpwuid), NOT $HOME — www-data's passwd
# home is /var/www, so setting HOME in the unit is not enough: ssh would look for
# the key in /var/www/.ssh and fail "Permission denied (publickey)". Name the
# identity and known_hosts explicitly. See /bugs_open/016.
export GIT_SSH_COMMAND="ssh -i /var/lib/sitesync/.ssh/id_ed25519 -o IdentitiesOnly=yes \
-o UserKnownHostsFile=/var/lib/sitesync/.ssh/known_hosts -o StrictHostKeyChecking=yes"

cd /var/lib/sitesync/repo
git fetch --quiet origin main
git reset --hard --quiet origin/main
rsync -a --delete idea.uk/ /var/www/idea.uk/
