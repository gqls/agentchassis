# /etc/systemd/system/sitesync.service — one sync pass (fired by sitesync.timer).
# Runs as www-data so everything rsync writes into /var/www/idea.uk is already
# correctly owned — no chown step, no root in the sync path.
[Unit]
Description=Sync idea.uk static site from gqls/vm-sites
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/local/bin/sitesync
# HOME is for git itself (.gitconfig). It does NOT point ssh at the deploy key —
# ssh expands `~` from the passwd entry (/var/www for www-data), not $HOME, so the
# sitesync script sets GIT_SSH_COMMAND with explicit -i / UserKnownHostsFile paths.
# See /bugs_open/016.
Environment=HOME=/var/lib/sitesync
