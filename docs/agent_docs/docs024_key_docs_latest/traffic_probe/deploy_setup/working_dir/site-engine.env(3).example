# site-engine.env.example — copy to /etc/site-engine/site-engine.env and fill in.
# setup.sh writes a placeholder if this file is absent; it never overwrites an
# existing one (so secrets survive re-runs).

# Engine listen port. MUST match SERVICE_PORT used by setup.sh (default 8080).
PORT=8080

# Data directory: counters.json + daily events-YYYYMMDD.jsonl. Under the
# service DATA_DIR so systemd's ReadWritePaths permits it.
ENGINE_DATA_DIR=/var/lib/site-engine

# Where /intent 303-redirects after a successful capture. A static page on the
# built site (e.g. /thanks.html), or / to return home.
THANKS_PATH=/

# Coarse country header, only if a CDN sets one (e.g. Cloudflare). Left as-is is
# harmless; the engine records "" when the header is absent. No IP is stored.
GEO_COUNTRY_HEADER=CF-IPCountry

# Cap on a captured value's length.
MAX_VALUE_LEN=500

# Gates GET /stats (sent as header X-Internal-Key). Set a strong random value.
INTERNAL_API_KEY=

# Optional allow-list of canonical hosts this box serves (comma-separated).
# Usually leave EMPTY: nginx already only routes configured server_names to the
# engine, so it never sees an unconfigured host. Set it only for defence-in-depth.
ACCEPT_HOSTS=

# CORS allow-list (comma-separated origins). Same-origin form posts don't need
# this; leave empty unless a page posts cross-origin.
ALLOWED_ORIGINS=

# Directory holding <domain>.access.log files for GET /access-digest.
# Default /var/log/nginx. The service user must be able to read these (setup.sh
# adds it to the adm group).
NGINX_LOG_DIR=/var/log/nginx
