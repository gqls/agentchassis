# idea.uk service environment — copy to /etc/idea/idea.env and fill in.
# Read by the systemd unit (EnvironmentFile). chmod 0640, owned root:idea.
#
# IMPORTANT: systemd EnvironmentFile does NOT strip inline comments. Every
# comment MUST be on its own line (starting with #). Never put "# ..." after a
# value on the same line — systemd makes it part of the value. (This crashed the
# first deploy: `PORT=8080  # ...` was read as the literal "8080  # ..." → an
# invalid port → the service exited 1 in a restart loop → nginx 502.)
#
# The service starts in FakeProvider (no real money) until BOTH Stripe vars are
# set; with both present it uses real Stripe. Keep AUTO_DELIVER=false until you
# trust the output.

# ── required ──────────────────────────────────────────────────────────────────
# the engine API key (required for real runs)
ANTHROPIC_API_KEY=sk-ant-api03-Rn...TKZWQAA
# must match SERVICE_PORT in setup.sh
PORT=8080
PUBLIC_BASE_URL=https://idea.uk
IDEA_DB_PATH=/var/lib/idea/orders.json
# where new-order notifications go (internal)
# OPERATOR_EMAIL=idea@contactforsales.com
# a long random secret; gates /confirm /decline /refund. Generate: openssl rand -hex 32
INTERNAL_API_KEY=bc4b818ff0b1c45a03170b97b84e3b968a9de68bf5c0535b5a1623f16510c8c3

# public support address shown on the page footer + the confirmation pages.
# Falls back to OPERATOR_EMAIL if left blank.
# CONTACT_EMAIL=idea@contactforsales.com
# header line reads "accepting <this> requests this month".
# Blank → "a limited number of". Or set a number, e.g. 5.
MONTH_SLOTS=5

# ── product / safety ────────────────────────────────────────────────────────────
# the £29 price (the binary default is a stale 199 — set this)
REPORT_PRICE_GBP=29
# hold paid reports for operator review until trusted
AUTO_DELIVER=false
# capacity cap; /confirm refuses beyond this
MAX_ACTIVE_ORDERS=5

# ── billing (absent → FakeProvider; both present → real Stripe) ──────────────────
# live
#  https://dashboard.stripe.com/acct_1RNfPL02nQ76FNif/apikeys
#  https://dashboard.stripe.com/acct_1RNfPL02nQ76FNif/workbench/webhooks
#  fake:
#  https://dashboard.stripe.com/acct_1RNfPY08YuzM2cqf/test/workbench/webhooks

# sk_test_... then sk_live_...
STRIPE_SECRET_KEY=sk_test_REDACTED
# whsec_... from the dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_jXA1SSVz0If6vKTaLOuSXoPPgAGybBu0
# fake
STRIPE_SECRET_KEY=rk_test_REDACTED

# Stripe live account
#----------------------
# RAK - restricted key - only permissions: Checkout Sessions → Write
STRIPE_SECRET_KEY=rk_live_REDACTED
# webhook secret only events: checkout.session.completed endpoint: https://idea.uk/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_REDACTED

# ── models (optional overrides; defaults are the best current) ───────────────────
# GEN_MODEL=claude-opus-4-8
# VERIFY_MODEL=claude-opus-4-8
# CRITIQUE_MODEL=claude-sonnet-4-6
# SCORE_MODEL=claude-sonnet-4-6
# WEB_SEARCH_MAX_USES=12

# ── cross-vendor cut (optional) ──────────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_CRITIQUE_MODEL=gpt-4o

# ── email delivery (absent → reports written to files instead of sent) ───────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=reports@idea.uk

# ── CORS (only if the page is served from a different origin than the service) ───
# ALLOWED_ORIGINS=https://idea.uk
# SMTP_PORT is not 587 as Clook doesn't support it officially

SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
# SMTP_PORT=465
SMTP_PORT=587
# outgoing is AWS SES service
# IAM_USER=ses-smtp-user.20260611-195505
SMTP_USER=AKIAUHJZKKDO6GVICJ4X
SMTP_PASS=BNpSwJFZiluQJAyW3hQxO3Z8HGdn2WmEfX2QAEkrxYn0
SMTP_FROM=idea-uk@leopardess.uk
SMTP_FROM_NAME=idea.uk
SMTP_REPLY_TO=idea-uk@leopardess.uk
CONTACT_EMAIL=idea-uk@leopardess.uk
OPERATOR_EMAIL=idea-uk@leopardess.uk
