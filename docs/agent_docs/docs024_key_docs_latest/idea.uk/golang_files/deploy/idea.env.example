# idea.uk service environment — copy to /etc/idea/idea.env and fill in.
# Read by the systemd unit (EnvironmentFile). chmod 0640, owned root:idea.
#
# The service starts in FakeProvider (no real money) until BOTH Stripe vars are
# set; with both present it uses real Stripe. Keep AUTO_DELIVER=false until you
# trust the output.

# ── required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # the engine. Required.
PORT=8080                    # must match SERVICE_PORT in setup.sh
PUBLIC_BASE_URL=https://idea.uk
IDEA_DB_PATH=/var/lib/idea/orders.json
OPERATOR_EMAIL=ops@idea.uk   # where new-order notifications go
INTERNAL_API_KEY=            # a long random secret; gates /confirm /decline /refund

# ── product / safety ────────────────────────────────────────────────────────────
REPORT_PRICE_GBP=29          # NB the binary default is a stale 199 — set this
AUTO_DELIVER=false           # hold paid reports for operator review until trusted
MAX_ACTIVE_ORDERS=8          # capacity cap; /confirm refuses beyond this

# ── billing (absent → FakeProvider; both present → real Stripe) ──────────────────
STRIPE_SECRET_KEY=           # sk_test_… then sk_live_…
STRIPE_WEBHOOK_SECRET=       # whsec_… from the dashboard webhook endpoint

# ── models (optional overrides; defaults are the best current) ───────────────────
# GEN_MODEL=claude-opus-4-8
# VERIFY_MODEL=claude-opus-4-8
# CRITIQUE_MODEL=claude-sonnet-4-6
# SCORE_MODEL=claude-sonnet-4-6
# WEB_SEARCH_MAX_USES=12       # verify search budget

# ── cross-vendor cut (optional) ──────────────────────────────────────────────────
# OPENAI_API_KEY=              # if set, the cut step runs on OpenAI instead of Sonnet
# OPENAI_CRITIQUE_MODEL=gpt-4o

# ── email delivery (absent → reports written to files instead of sent) ───────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=reports@idea.uk

# ── CORS (only if the page is served from a different origin than the service) ───
# ALLOWED_ORIGINS=https://idea.uk
