# idea.uk service — environment. Copy to .env and fill in. Never commit secrets.

# ── Engine ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional: genuine cross-vendor critique for the cut step. If set, STEP 3 runs
# on OpenAI instead of a second Anthropic model. Set the model to a current one.
# OPENAI_API_KEY=sk-...
# OPENAI_CRITIQUE_MODEL=gpt-4o

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# Omit both to run with the FakeProvider for local end-to-end testing.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
REPORT_PRICE_GBP=199

# ── Service ──────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://idea.uk
# Shared key for operator actions (/confirm, /decline) and /internal/run:
INTERNAL_API_KEY=change-me-openssl-rand-hex-16
OPERATOR_EMAIL=you@idea.uk
# Origins allowed to call the service (the static page's origin). Comma-sep.
ALLOWED_ORIGINS=https://idea.uk
# Max orders in flight before /confirm refuses (protects the 72h promise).
MAX_ACTIVE_ORDERS=8
# OFF during early access: paid runs are held for operator review before sending.
AUTO_DELIVER=false
IDEA_DB_PATH=/data/idea_orders.db

# ── Email delivery (optional; without SMTP_HOST, reports are written to files) ─
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM=reports@idea.uk
