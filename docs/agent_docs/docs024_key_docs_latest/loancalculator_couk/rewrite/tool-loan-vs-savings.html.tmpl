<style>
/* tool-loan-vs-savings — SELF-CONTAINED by design.
   Namespaced under .tool-loan-vs-savings-section. The original depended on the
   page for .card, .input-grid, .comparison-card, .result-panel, .monthly-payment
   AND for the `.winner` highlight — which is the tool's entire answer. A site
   whose stylesheet lacks .winner shows two identical panels and no verdict, while
   every selector still matches and the numbers are still correct. That class is
   defined here now, so the verdict cannot be lost by a stylesheet rewrite.
   The select's four inline style declarations are CSS here instead.
   No `display` is set on any [id] element: those are the fingerprint. */
.tool-loan-vs-savings-section {
  color: var(--color-text, #333);
}
.tool-loan-vs-savings-section .lvs-card {
  background: var(--color-card-bg, #ffffff);
  border: 1px solid var(--color-border, #e2e8f0);
  border-radius: var(--border-radius, 0.5rem);
  box-shadow: var(--shadow, 0 1px 4px rgba(0,0,0,0.07));
  padding: 1.5rem;
}
.tool-loan-vs-savings-section .lvs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}
.tool-loan-vs-savings-section label {
  display: block;
  margin-bottom: 0.35rem;
  font-weight: 600;
  font-size: 0.95rem;
}
.tool-loan-vs-savings-section input[type="number"],
.tool-loan-vs-savings-section select {
  width: 100%;
  box-sizing: border-box;
  padding: 0.6rem 0.7rem;
  font-size: 1rem;
  border: 1px solid var(--color-border, #cbd5e1);
  border-radius: var(--border-radius-sm, 0.25rem);
  background: var(--color-input-bg, #ffffff);
  color: inherit;
}
.tool-loan-vs-savings-section .lvs-panels {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
  margin-top: 1.25rem;
}
.tool-loan-vs-savings-section .lvs-panel {
  background: var(--color-card-bg, #ffffff);
  border: 2px solid var(--color-border, #e2e8f0);
  border-radius: var(--border-radius, 0.5rem);
  padding: 1.25rem;
  text-align: center;
  transition: border-color 0.2s, background 0.2s;
}
.tool-loan-vs-savings-section .lvs-panel h3 { margin: 0 0 0.5rem; font-size: 1.05rem; }
.tool-loan-vs-savings-section .lvs-panel p { margin: 0.25rem 0; font-size: 0.95rem; }
.tool-loan-vs-savings-section .lvs-amount {
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.2;
  margin: 0.35rem 0;
}
/* THE VERDICT — FIXED 2026-08-03, as its own change with its own re-baseline.
   The winning option used to be signalled by colour and border weight ALONE.
   That is this tool's entire output and it was invisible to a colour-blind
   reader; the two panels are otherwise identical in structure. A badge was
   written during the port and REVERTED, because a port proves equivalence and an
   improvement is its own change — the same line that kept the three-decimal
   money bug in tool-overpayment-impact. This is that change.
   The badge is real TEXT inside the winning panel, so it survives a stylesheet
   that drops .winner, it reads aloud, and it is legible in monochrome. The
   colour stays: it is a second channel, not the only one.
   ⚠ The badge span is present in BOTH panels at all times and is emptied on the
   loser rather than removed. Toggling the element in and out of the DOM would
   move `display` on an [id]-bearing element, which is fingerprinted, so a purely
   presentational choice would show up as a structural diff on every capture. */
.tool-loan-vs-savings-section .lvs-panel.winner {
  border-color: var(--color-success, #2f855a);
  background: var(--color-success-bg, #f0fff4);
}
/* The badge element is a DIV, not a SPAN carrying `display: block`, precisely so
   that this rule sets no `display` on an [id] element — see the file header. Its
   natural block display is what reserves the row, so the panels do not jump as
   the winner changes; `min-height` holds that row open while the badge is empty.
   (Tag names are spelled out in this comment on purpose: load_components.py
   balances start and end tags TEXTUALLY, so an angle-bracketed tag in prose is
   counted as real markup and fails validation. It caught this comment.) */
.tool-loan-vs-savings-section .lvs-badge {
  min-height: 1.25rem;
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-success, #2f855a);
}
.tool-loan-vs-savings-section .lvs-copy { display: none; }
@media (max-width: 560px) {
  .tool-loan-vs-savings-section .lvs-amount { font-size: 1.6rem; }
}
</style>

<section class="tool-loan-vs-savings-section">
  <div class="lvs-card">
    <div class="lvs-grid">
      <div>
        <label for="loan-rate">{{.loan_rate_label}}</label>
        <input type="number" id="loan-rate" value="{{.loan_rate_default}}">
      </div>
      <div>
        <label for="save-rate">{{.save_rate_label}}</label>
        <input type="number" id="save-rate" value="{{.save_rate_default}}">
      </div>
      <div>
        <label for="spare-cash">{{.spare_cash_label}}</label>
        <input type="number" id="spare-cash" value="{{.spare_cash_default}}">
      </div>
      <div>
        <label for="tax-bracket">{{.tax_label}}</label>
        <select id="tax-bracket">
          <option value="0">{{.tax_basic_option}}</option>
          <option value="{{.higher_rate_fraction}}">{{.tax_higher_option}}</option>
        </select>
      </div>
    </div>
  </div>

  <div class="lvs-panels" id="results">
    <div id="loan-panel" class="lvs-panel">
      <div class="lvs-badge" id="loan-badge"></div>
      <h3>{{.loan_panel_heading}}</h3>
      <p>{{.loan_panel_lead}}</p>
      <div class="lvs-amount" id="loan-benefit">{{.currency_symbol}}75.00</div>
      <p>{{.loan_panel_trail}}</p>
    </div>
    <div id="save-panel" class="lvs-panel">
      <div class="lvs-badge" id="save-badge"></div>
      <h3>{{.save_panel_heading}}</h3>
      <p>{{.save_panel_lead}}</p>
      <div class="lvs-amount" id="save-benefit">{{.currency_symbol}}50.00</div>
      <p>{{.save_panel_trail}}</p>
    </div>
  </div>

  <!-- Copy bank: the badge string as markup text, never as a JS literal — the
       same idiom as tool-consolidation-risk, and for the same reason (see
       tool-early-settlement for the calculator a quoted schema value killed).
       It is NOT rendered into the badges directly, because then a page whose
       JavaScript failed would show "Better option" on BOTH panels and assert
       the opposite of nothing. The badges start empty and the script fills
       exactly one. Outside every [id]-bearing element, so the fingerprint is
       unaffected. -->
  <div class="lvs-copy" aria-hidden="true">
    <span data-copy="winner-badge">{{.winner_badge_label}}</span>
  </div>
</section>

<script>
/* === tool-doc ===
  name: Pay Off Loan or Save?
  function: tool-loan-vs-savings
  page: tool-loan-vs-savings (/tools/loan-vs-savings.html)
  description: Compares one year of interest avoided by clearing debt against one year of net interest earned by saving the same sum, adjusted for the saver's tax band.
  behaviour: |
    - Loan side: amount x rate. Savings side: amount x rate x (1 - tax fraction).
    - The larger side gets the .winner class.
    - higher_rate_fraction is a FRACTION (0.4), not a percentage.
  invariants: |
    £1,000 at 7.5% against 5.0% MUST read £75.00 versus £50.00. On an exact tie the SAVINGS panel wins (the comparison is strict) — recorded behaviour, not a decision. The verdict is carried by TWO channels: the .winner highlight and a text badge in the winning panel. Exactly one badge is ever non-empty — if both read "Better option", compare() has not run.
  verified: computed_values fence emitted from a captured golden; the rewrite is
    proven identical to the hand-built original across three input vectors
    (see loancalculator_couk/rewrite/verify_rewrite.py).
  === /tool-doc === */
/* ARITHMETIC PRESERVED EXACTLY from the hand-built original
   (loancalculator.co.uk/tools/loan-vs-savings.html, 2026-07-31): one year of
   simple interest on the same sum at each rate, with the savings side reduced by
   the taxpayer's marginal rate. £1,000 at 7.5% against 5.0% must read £75.00
   versus £50.00.

   THE COMPARISON IS DELIBERATELY SIMPLE AND SHOULD STAY SO. It is one year,
   undiscounted, and it ignores the Personal Savings Allowance — which the page
   copy explains, and which is why the tax control is a blunt two-option select
   rather than a rate field. Making the arithmetic cleverer without changing the
   copy would produce a tool that disagrees with its own explanation.

   THE 2026-08-03 CHANGE — the accessible verdict. The winning panel now carries
   a text badge as well as the .winner highlight. It moves the fingerprint (two
   new ids, and their text changes with the verdict), which is why it waited for
   its own re-baseline instead of riding the port. It cannot move a NUMBER:
   loanSave, saveEarn and the winner test are untouched, and the equivalence gate
   run over this change must show `loan-benefit` and `save-benefit` unchanged on
   every vector. If either of those moved, the badge is not what did it.

   TWO deliberate changes from the port, neither of which can move a number:
   1. No globals and no inline oninput/onchange. `compare` was on window and bound
      through four inline attributes.
   2. The higher-rate fraction is a schema field rather than the literal 0.4
      buried in an <option value>, so a change in the tax band is a config edit.
      The winner test is unchanged, including its tie behaviour: on an exact tie
      the SAVINGS panel wins, because the original's `if (loanSave > saveEarn)`
      is a strict comparison and its else branch takes the tie. That is arguably
      the wrong default for a debt-first tool, but it is the recorded behaviour
      and changing it is a decision, not a port. */
(function () {
  var SYM = "{{.currency_symbol}}";
  var root = document.querySelector('.tool-loan-vs-savings-section');
  if (!root) return;
  var ids = ['loan-rate', 'save-rate', 'spare-cash', 'tax-bracket'];

  function copy(key) {
    var el = root.querySelector('[data-copy="' + key + '"]');
    return el ? el.textContent : '';
  }

  function compare() {
    var loanRate = parseFloat(document.getElementById('loan-rate').value) / 100;
    var saveRate = parseFloat(document.getElementById('save-rate').value) / 100;
    var amount = parseFloat(document.getElementById('spare-cash').value);
    var tax = parseFloat(document.getElementById('tax-bracket').value);

    var netSaveRate = saveRate * (1 - tax);
    var loanSave = amount * loanRate;
    var saveEarn = amount * netSaveRate;

    document.getElementById('loan-benefit').innerText = SYM + loanSave.toFixed(2);
    document.getElementById('save-benefit').innerText = SYM + saveEarn.toFixed(2);

    var loanPanel = document.getElementById('loan-panel');
    var savePanel = document.getElementById('save-panel');
    var loanBadge = document.getElementById('loan-badge');
    var saveBadge = document.getElementById('save-badge');
    var badge = copy('winner-badge');

    loanPanel.classList.remove('winner');
    savePanel.classList.remove('winner');

    // The winner test is UNCHANGED, tie behaviour included: `>` is strict, so an
    // exact tie takes the else branch and savings wins. Arguably wrong for a
    // debt-first tool, but it is the recorded behaviour and changing it is a
    // different decision from making the verdict readable.
    var loanWins = loanSave > saveEarn;
    (loanWins ? loanPanel : savePanel).classList.add('winner');

    // Text, not just colour. Exactly one badge carries the string at any time.
    loanBadge.innerText = loanWins ? badge : '';
    saveBadge.innerText = loanWins ? '' : badge;
  }

  ids.forEach(function (id) {
    var el = document.getElementById(id);
    el.addEventListener('input', compare);
    el.addEventListener('change', compare);
  });
  compare();
})();
</script>
