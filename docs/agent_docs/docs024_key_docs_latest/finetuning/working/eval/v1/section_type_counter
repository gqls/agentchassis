python3 << 'PY'
import json
from collections import Counter
counts = Counter()
keysets = []
with open('held_out_cases_v1.jsonl') as f:
    for line in f:
        try:
            row = json.loads(line)
            d = json.loads(row['messages'][1]['content'])
            if not isinstance(d, dict):
                counts['parse_error'] += 1
                continue
            keys = set(d.keys())
            keysets.append(tuple(sorted(keys)))
            if {'headline','primary_cta','primary_cta_url'}.issubset(keys):
                counts['hero_with_cta'] += 1
            elif keys <= {'headline','subheadline'}:
                counts['minimal_hero'] += 1
            elif 'menu_items' in keys or 'links' in keys:
                counts['header_nav'] += 1
            else:
                counts['other'] += 1
        except Exception as e:
            counts['parse_error'] += 1
print('Categories:', dict(counts))
print('Distinct key sets:')
for ks, n in Counter(keysets).most_common():
    print(f'  {n}: {list(ks)}')
