# Island: /opt/island/Caddyfile — served by the caddy container on :8081.
# Only /api/v1/tools/* is forwarded; 1MB body cap; everything else 404.
# Rate limiting lives at the Cloudflare edge rule + in tools-api's own
# middleware — the stock caddy image has no ratelimit plugin, so none here
# (this replaces the bastion draft's caddy-ratelimit dependency).
{
  auto_https off   # TLS terminates at Cloudflare; the tunnel delivers locally
}
:8081 {
  @tools path /api/v1/tools/*
  handle @tools {
    request_body {
      max_size 1MB
    }
    reverse_proxy tools-api:8080   # compose service name; port confirmed at PR time
  }
  handle {
    respond 404
  }
}

# features_open/020 stage 1 — passive traffic probe for every OTHER apis.uk
# hostname (wildcard + apex ride the tunnel here). Serves nothing but 404;
# the access log is the product: JSON per request incl. Host, method, uri and
# all forwarded headers (Referer, User-Agent, CF-Connecting-IP, CF-IPCountry).
# Caddy's own log rolling gives the 30-day retention — no host logrotate.
:8082 {
  log probe {
    output file /var/log/caddy/probe_access.log {
      roll_size 10MiB
      roll_keep 10
      roll_keep_for 720h
    }
    format json
  }
  respond 404
}
