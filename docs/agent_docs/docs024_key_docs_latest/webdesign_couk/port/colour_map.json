    { "hex": "#eab308", "to": "var(--warn)" },
    { "hex": "#f59e0b", "to": "var(--warn)" },
    { "hex": "#ca8a04", "to": "var(--warn)" },

    { "_comment": "--- second pass: everything the first transform run reported as unmapped. Grouped by what the literal was DOING, read from its declaration, not guessed from its hue.",

      "hex": "#f0f0f0", "to": "var(--surface)" },
    { "hex": "#f8fafc", "to": "var(--surface)" },
    { "hex": "#f3f4f6", "to": "var(--surface)" },
    { "hex": "#f5f8fa", "to": "var(--surface)" },
