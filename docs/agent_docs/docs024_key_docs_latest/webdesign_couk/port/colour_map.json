{
  "_why": "Literal hex colours are what pin each ported page to its old skin. This maps them onto the warm system, PROPERTY-AWARE: #111 means ink under `color:` and a dark decorative panel under `background:`. Contexts are text | background | border | shadow | flipped, or omitted for 'any'. `flipped` applies to a text colour sitting in the same declaration block as a background that this map turned from dark to light — without it, a rescued `color:#fff` would be white on white. Literals inside <script> are never touched (tool data, not skin); the transform reports them instead.",

  "_allowlist_why": "Functional colours: a colour tool's own default swatch or sample value. Rewriting these would break the tool while looking like a successful reskin.",
  "allowlist": [
    "#ff00cc", "#00ffcc", "#ff0080", "#8000ff", "#00d4ff",
    "#ff6b6b", "#4ecdc4", "#45b7d1", "#f7b731", "#5f27cd"
  ],

  "rules": [
    { "hex": "#0055ff", "to": "var(--primary)", "why": "Site A's electric blue accent — the single strongest signal of the old Swiss identity" },
    { "hex": "#4d94ff", "to": "var(--primary)", "why": "Site A's dark-mode accent variant" },
    { "hex": "#3b82f6", "to": "var(--primary)", "why": "stray tailwind blue" },

    { "hex": "#111111", "contexts": ["text"], "to": "var(--text)" },
    { "hex": "#111111", "contexts": ["background"], "to": "var(--bg-panel)", "flips_block": true, "why": "Site A ink panels AND Site B's dark terminal panels" },
    { "hex": "#111111", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#000000", "contexts": ["text"], "to": "var(--text)", "why": "never pure black — design_intent avoid list" },
    { "hex": "#000000", "contexts": ["background"], "to": "var(--code-bg)", "flips_block": true },
    { "hex": "#1a1a1a", "contexts": ["background"], "to": "var(--bg-panel)", "flips_block": true },
    { "hex": "#1a1a1a", "contexts": ["text"], "to": "var(--text)" },
    { "hex": "#0a0a0c", "contexts": ["background"], "to": "var(--bg)", "flips_block": true },
    { "hex": "#0f0f0f", "contexts": ["background"], "to": "var(--bg)", "flips_block": true },
    { "hex": "#0f0f10", "contexts": ["background"], "to": "var(--bg)", "flips_block": true },
    { "hex": "#0f1115", "contexts": ["background"], "to": "var(--bg)", "flips_block": true },
    { "hex": "#1a1d24", "contexts": ["background"], "to": "var(--bg-panel)", "flips_block": true },
    { "hex": "#161618", "contexts": ["background"], "to": "var(--bg-panel)", "flips_block": true },
    { "hex": "#1d1d20", "contexts": ["background"], "to": "var(--bg-panel)", "flips_block": true },
    { "hex": "#222222", "contexts": ["background"], "to": "var(--surface)", "flips_block": true },
    { "hex": "#222222", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#2a2a2a", "contexts": ["background"], "to": "var(--surface)", "flips_block": true },
    { "hex": "#2a2a2a", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#2e2e33", "contexts": ["border"], "to": "var(--border)" },

    { "hex": "#1e1e1e", "contexts": ["background"], "to": "var(--code-bg)", "flips_block": true, "why": "Site A's code-block background, 51 occurrences" },
    { "hex": "#1e1e1e", "contexts": ["text"], "to": "var(--text)" },
    { "hex": "#a9ff68", "to": "var(--code-accent)", "why": "Site A's terminal green, 37 occurrences" },
    { "hex": "#00ff00", "to": "var(--code-accent)", "why": "Site B's terminal green (#0f0), 15 occurrences" },

    { "hex": "#333333", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#333333", "contexts": ["background"], "to": "var(--surface)", "flips_block": true },
    { "hex": "#333333", "contexts": ["text"], "to": "var(--text)" },
    { "hex": "#444444", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#444444", "contexts": ["background"], "to": "var(--surface)", "flips_block": true },
    { "hex": "#444444", "contexts": ["text"], "to": "var(--text-dim)" },

    { "hex": "#555555", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },
    { "hex": "#555555", "contexts": ["background"], "to": "var(--border-hover)", "flips_block": true, "why": "usually the HOVER partner of a #333 base; both mapping to --surface collapsed the hover" },
    { "hex": "#666666", "contexts": ["text", "flipped"], "to": "var(--text-dim)", "why": "141 occurrences on Site A" },
    { "hex": "#666666", "contexts": ["background"], "to": "var(--surface)", "flips_block": true },
    { "hex": "#777777", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },
    { "hex": "#888888", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },
    { "hex": "#888888", "contexts": ["border"], "to": "var(--border-hover)" },
    { "hex": "#999999", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },
    { "hex": "#aaaaaa", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },
    { "hex": "#717171", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },

    { "hex": "#ffffff", "contexts": ["background"], "to": "var(--bg-panel)" },
    { "hex": "#ffffff", "contexts": ["flipped"], "to": "var(--text)", "why": "was white-on-dark; the panel is now light" },
    { "hex": "#ffffff", "contexts": ["text"], "to": "#ffffff", "why": "identity — white on a still-dark button (e.g. background:var(--color-ink)) is correct in the warm system, whose own hero CTA is a dark filled button. Mapped explicitly so it is not reported as unmapped." },
    { "hex": "#ffffff", "contexts": ["border"], "to": "var(--bg-panel)" },
    { "hex": "#ededed", "contexts": ["text"], "to": "var(--text)" },

    { "hex": "#f4f4f5", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#f4f4f5", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#f8f8f8", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#f9f9f9", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#fafafa", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#f5f5f5", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#eeeeee", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#eeeeee", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#e4e4e7", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#e4e4e7", "contexts": ["background"], "to": "var(--border-hover)", "why": "usually a HOVER background whose base is #f4f4f5. Both mapping to --surface collapsed the hover into its base — caught by eye on tool-aspect-ratio." },
    { "hex": "#dddddd", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#dddddd", "contexts": ["background"], "to": "var(--surface)" },
    { "hex": "#cccccc", "contexts": ["border"], "to": "var(--border-hover)" },
    { "hex": "#cccccc", "contexts": ["text", "flipped"], "to": "var(--text-dim)" },

    { "hex": "#eff6ff", "contexts": ["background"], "to": "var(--callout-bg)" },
    { "hex": "#bfdbfe", "contexts": ["border"], "to": "var(--callout-border)" },
    { "hex": "#bfdbfe", "contexts": ["background"], "to": "var(--callout-bg)" },

    { "hex": "#ff6b00", "to": "var(--accent)", "why": "Site B's abandoned brand orange" },
    { "hex": "#e66000", "to": "var(--primary-hover)", "why": "its hover partner" },
    { "hex": "#6366f1", "to": "var(--accent)", "why": "the indigo 'AI UTILITY' eyebrow" },
    { "hex": "#ec4899", "to": "var(--accent)" },

    { "hex": "#ff4444", "to": "var(--danger)" },
    { "hex": "#ef4444", "to": "var(--danger)" },
    { "hex": "#dc2626", "to": "var(--danger)" },
