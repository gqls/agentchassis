    { "hex": "#0f1419", "contexts": ["text"], "to": "var(--text)" },
    { "hex": "#999999", "to": "var(--border-hover)", "why": "any non-text use is a hairline" },
    { "hex": "#000000", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#555555", "contexts": ["border"], "to": "var(--border)" },
    { "hex": "#cccccc", "to": "var(--border-hover)", "why": "catch-all: also appears inside linear-gradient() checkerboards in the image tools, which the property classifier reports as 'other'" },

