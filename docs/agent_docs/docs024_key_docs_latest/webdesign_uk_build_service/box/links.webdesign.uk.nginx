# /etc/nginx/sites-available/links.webdesign.uk — the emailed-links origin.
#
# ⚠ Adding a hostname or location that proxies into the CLUSTER ⇒ cite register
# SYS-094 (the standing exposure pattern) or file an RFC first — RFC_054 Q3,
# owner ruling 2026-08-25.
#
# OWNER RULING 2026-08-24: /c/ moves OFF the shopfront hostname. The trap it
# closes (LANDMINES: "A CLOUDFLARE PAGE RULE PUT THERE FOR PARKING..."): the
# apex vhost carried /c/, and the only thing keeping it off the internet was
# the page rule parking webdesign.uk — so shipping the shopfront would have
# exposed a state-changing route as a side effect. This hostname is public ON
# PURPOSE instead: customers click these links from the delivery email, and
# the exposure is exactly one path, chosen, not inherited.
#
# WHY "links.": it reads honestly in an email, and it is where /d/<token>
# (the ZIP download, still blocked on its own design) will live when built —
# one hostname for everything a customer is sent, nothing else on it.
#
# SAFE TO EXPOSE NOW, measured 2026-08-24: the prefetch guard is LIVE in the
# running core-manager (v1.0.1332 carries 0e9cb31ee — HEAD/announced
# speculative fetches refused, 412 + no-store), and customer_access_tokens
# holds 0 rows, so there is no token to guess and no state to corrupt. The
# RESIDUAL still stands and moving hostname does not touch it: a mail
# scanner's plain GET is indistinguishable from a real click. RULED 2026-08-24:
# the second click IS required — GET /c/ becomes a render-only confirmation
# page, the mutation moves to a POST from its button, and NO delivery email is
# sent before that page ships (DECISION_2026-08-24_confirmation_needs_a_second_click.md).
# This vhost needs no change for it: the anchored /c/ location below passes
# GET and POST alike (`limit_except GET POST`).
#
# Same posture as every vhost on this box: loopback only, tunnel dials out,
# ufw default-deny. Same tunnel caveats as webdesign.uk.nginx: no X-Real-IP,
# rate-limit keyed on CF-Connecting-IP, static proxy_pass resolves at reload.
#
# ⚠ THE LOCATION IS THE EXPOSURE. The anchored regex below
# (`^/c/[A-Za-z0-9_-]{20,128}$`) proxies EXACTLY the confirm-transfer path —
# not a `/c/` prefix, which is what this comment used to say. Do NOT widen it
# to `/`, loosen the anchor, or add a longer prefix of core-manager's routes.
#
# UPDATED 2026-08-25 — that sentence used to be the ONLY thing between the
# internet and the admin API, and it is not any more. The upstream is now
# core-manager:**8090**, the DELIVERY LISTENER, which serves the customer
# routes and nothing else: no admin API, no bootstrap, no facts relay, no
# health. Widening this location now exposes /c/ and /d/ and stops there.
# RFC_054 Q2, owner ruling 2026-08-25; register SYS-095.
#
# The old reasoning still applies to anyone adding a NEW location: 8088 is
# still reachable from this box (the chat bot's facts relay needs it), so a
# vhost written straight to :8088 would reach the whole admin API and
# sitefacts.go's "no public exposure" reasoning would be silently false again.
# The containment is this location's upstream, not the fence.
#
# ⚠⚠ DO NOT APPLY THIS FILE BEFORE THE ROLL THAT CARRIES THE LISTENER.
# Port 8090 does not answer until a core-manager image built from the commit
# adding it is running. Apply this first and every customer link 404s at the
# box, with nothing wrong in the cluster and no error anywhere to find. Check
# before applying, and use the reversed test as a control:
#   kubectl -n ai-persona-system logs -l app=core-manager --tail=2000 \
#     | grep -m1 'build provenance'
#   git merge-base --is-ancestor <the listener commit> <the stamp>
# Harmless to be late: until this file is applied the box still proxies to
# 8088, where the routes no longer are, so /c/ 404s either way until both
# halves are in place. `customer_access_tokens` = 0 [MEASURED 2026-08-25], so
# no customer can be holding a link while that is true.
#
# ⚠ THE UPSTREAM RIDES THE WIREGUARD EGRESS FENCE. This vhost's upstream is
# core-manager:8090 (the delivery listener), on the allowlist alongside 8088
# (which the chat bot's facts relay still needs)
# (networkpolicy-wireguard-egress.yaml). Narrow that policy and this vhost
# times out in a way that reads as core-manager being down. [Corrected
# 2026-08-26: this note still said 8088 after the 8090 repoint.]

limit_req_zone $http_cf_connecting_ip zone=links_rl:10m rate=20r/m;

server {
    listen 127.0.0.1:8084;
    server_name links.webdesign.uk;

    # Hardening pass 2026-08-24 (owner asked for more between this host and the
    # cluster). Nothing that is not token-shaped crosses the WireGuard leg:
    #  - the regex admits exactly /c/<token> — tokens are 32 random bytes in
    #    base64url (43 chars, charset [A-Za-z0-9_-]); the handler's own
    #    maxTokenLen is 128, mirrored here. Traversal, encodings, overlong junk
    #    and probe paths all die at the box as a local 404.
    #  - the second-click POST (DECISION_2026-08-24) uses the SAME path with the
    #    method as the distinction, so this regex keeps holding when it ships.
    #  - methods beyond GET/HEAD/POST are refused here, not forwarded.
    #  - noindex on everything: this hostname exists only inside emails; it
    #    should never appear in an index or advertise itself.
    server_tokens off;

    location ~ "^/c/[A-Za-z0-9_-]{20,128}$" {
        limit_req zone=links_rl burst=3 nodelay;
        limit_except GET POST { deny all; }
        client_max_body_size    4k;
        add_header X-Robots-Tag "noindex, nofollow" always;
        # PORT 8090 IS THE DELIVERY LISTENER, NOT THE ADMIN API. See the
        # ⚠ DO NOT APPLY BEFORE THE ROLL note in this file's header.
        proxy_pass              http://core-manager.ai-persona-system.svc.cluster.local:8090;
        proxy_http_version      1.1;
        proxy_set_header Host   $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout      15s;
        proxy_send_timeout      15s;
    }

    # /d/<token> — the ZIP download (added 2026-08-26, same commit as the
    # core-manager route and its boxServablePrefixes entry, as the guard
    # demands). GET only: a download is idempotent, and the handler 302s to a
    # short-lived presign or renders an honest page; it never mutates state a
    # scanner could reach. Same anchored token shape as /c/.
    # ⚠ DO NOT APPLY BEFORE THE ROLL THAT CARRIES THE /d/ ROUTE — same rule as
    # the header's, same ancestry check; early application 404s at :8090
    # instead of at the box, which at least leaves a cluster log line.
    location ~ "^/d/[A-Za-z0-9_-]{20,128}$" {
        limit_req zone=links_rl burst=3 nodelay;
        limit_except GET { deny all; }
        client_max_body_size    4k;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass              http://core-manager.ai-persona-system.svc.cluster.local:8090;
        proxy_http_version      1.1;
        proxy_set_header Host   $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout      15s;
        proxy_send_timeout      15s;
    }

    location / {
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 404;
    }
}
