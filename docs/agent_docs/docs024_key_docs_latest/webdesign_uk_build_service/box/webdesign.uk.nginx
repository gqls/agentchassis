# /etc/nginx/sites-available/webdesign.uk — the tunnel origin.
#
# LISTENS ON LOOPBACK ONLY, ON PURPOSE. Ingress is a cloudflared tunnel dialling
# out from this box; nothing ever connects inbound (ufw default-deny backs this
# up). Binding 127.0.0.1 means even a firewall mistake exposes nothing.
# The tunnel's config will point at http://127.0.0.1:8080.
#
# Phase 4 chat service is live: /api/chat and /health proxy to 127.0.0.1:8081,
# copying idea.uk's proxy_tool.conf pattern (idea_uk_vm_site/box/proxy_tool.conf)
# — a rate limit as belt-and-braces on top of the app's own per-IP limiter.
# /stripe/webhook is WIRED (2026-08-15, owner ruling: webhook exposure = box
# proxy, option (a)) but live-meaningful only once the owner adds the Stripe
# keys — until then auth-service answers 503 "billing provider not configured",
# which is the honest keyless state, never a silent fake. The block copies
# proxy_stripe.conf's shape (idea_uk_vm_site/box/proxy_stripe.conf) minus
# X-Real-IP per the tunnel warning below: NO rate limit on that location
# (Stripe retries webhooks in bursts; a 503 there reads as an outage and
# delays/loses payment confirmation), and never let anything rewrite the
# body — Stripe verifies a signature over the RAW bytes.
#
# ⚠️ THIS BOX IS BEHIND A CLOUDFLARE TUNNEL, UNLIKE idea.uk. Do NOT copy
# idea.uk's `proxy_set_header X-Real-IP $remote_addr;` — on this box
# $remote_addr is cloudflared's own local connection, not the visitor, and
# setting it would inject a false value that could shadow the real one
# downstream. The visitor's real address arrives as CF-Connecting-IP, already
# on the request when it reaches nginx (Cloudflare's edge sets it and
# overwrites anything the client tried to send) — leave it untouched and let
# proxy_pass forward it as-is. The SAME care applies to the rate-limit zone
# below: keying it on $binary_remote_addr would be ONE GLOBAL BUCKET for every
# visitor (bugs_open/139's exact class, this time in nginx config rather than
# app code) — key on $http_cf_connecting_ip instead.

limit_req_zone $http_cf_connecting_ip zone=chat_rl:10m rate=10r/m;

server {
    listen 127.0.0.1:8080;
    server_name webdesign.uk www.webdesign.uk;

    root /var/www/webdesign.uk;
    index index.html;

    # Framework-built static pages.
    location / {
        try_files $uri $uri/ =404;
    }

    # Chat intake (Phase 4). The Go service does its own per-IP + turn-cap +
    # daily-spend gating (webdesign-chat, PLAN §5.1) — this limit_req is a
    # second, coarser layer against a raw connection flood, not the real
    # control.
    location /api/chat {
        limit_req zone=chat_rl burst=5 nodelay;
        proxy_pass              http://127.0.0.1:8081;
        proxy_http_version      1.1;
        proxy_set_header Host   $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout      30s;
        proxy_send_timeout      30s;
    }

    # Stripe webhook (PAY-009) — THE MONEY PATH. proxy_stripe.conf's shape:
    # deliberately NO limit_req (Stripe retries in bursts; throttling here
    # delays or loses payment confirmation), no body rewrite ever (the
    # endpoint authenticates by HMAC over the RAW bytes — that signature is
    # also why an unauthenticated public route is safe to leave standing).
    # Upstream is auth-service in the cluster over wg0, not a local process.
    # ⚠ 10.21.217.63 is auth-service's pinned ClusterIP — box cluster-DNS is
    # unresolved (same fragility as FACTS_URL in /etc/webdesign-chat.env:
    # survives pod restarts, NOT a Service recreate). Move both to names when
    # box DNS lands. Verified 2026-08-15: dummy POST end to end returns the
    # 503 keyless truth from auth-service in ~12ms.
    location = /stripe/webhook {
        proxy_pass              http://10.21.217.63:8081/api/v1/billing/webhooks/stripe;
        proxy_http_version      1.1;
        proxy_set_header Host   $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout      30s;
        proxy_send_timeout      30s;
    }

    # check_backend_unreachable's contract: this must exercise nginx AND the
    # engine behind it. A static `return 200` here would be a lie-shaped pass
    # — the engine's own /health handler (health.go) does a real disk
    # round-trip and confirms its API key is configured.
    location /health {
        proxy_pass              http://127.0.0.1:8081;
        proxy_http_version      1.1;
        proxy_set_header Host   $host;
        proxy_read_timeout      10s;
    }

    # security headers, matching the estate's baseline
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}
