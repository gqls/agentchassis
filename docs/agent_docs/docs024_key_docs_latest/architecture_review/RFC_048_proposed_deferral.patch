+			t.Error("Deferred must be false when the switch is set — the legacy path defers nothing")
+		}
+		if err := mock.ExpectationsWereMet(); err != nil {
+			t.Errorf("expectations: %v", err)
+		}
+	})
+
+	t.Run("arm A drops the item again", func(t *testing.T) {
+		t.Setenv("DISABLE_ANTI_CHURN_DEFERRAL", "1")
+		db, mock := newInsertMock(t)
