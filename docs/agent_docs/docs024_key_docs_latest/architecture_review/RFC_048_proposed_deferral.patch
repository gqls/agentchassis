+		mock.ExpectQuery(regexp.QuoteMeta("SELECT COUNT(*),")).
+			WillReturnRows(sqlmock.NewRows([]string{"count", "age"}).AddRow(1, 1.0))
+		// No INSERT registered.
+		//
+		// NOT A VACUOUS ABSENCE ASSERTION. If the mutation under test — deleting
+		// the switch, or inverting its sense — makes the code insert here, sqlmock
+		// returns "call to ExecQuery ... was not expected", and writeWorkItem
+		// RETURNS that error (`insert failed for %s: %w`) rather than logging past
+		// it. The t.Fatalf below is what fires. The landmine's swallowing case is
+		// the anti-churn PROBE, whose error is deliberately ignored; the INSERT's
+		// is not.
+
+		tx, err := db.Begin()
+		if err != nil {
+			t.Fatalf("begin: %v", err)
+		}
+		w, err := writeWorkItem(context.Background(), tx, baseItem(), dropOnConflict, zap.NewNop())
