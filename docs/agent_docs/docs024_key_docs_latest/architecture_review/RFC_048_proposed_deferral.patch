+// The disarm lever must produce EXACTLY the pre-326 behaviour on both arms —
+// that is the whole point of shipping one, and an untested lever is a lever
+// nobody can safely pull.
+//
+// This is also where the two assertions deleted from work_item_recurrence_test.go
+// went: the branded 'unresolved' row and the silent drop. They were correct
+// descriptions of the old behaviour and they are still correct descriptions of
+// what disarming restores, so they are kept rather than thrown away.
+func TestAntiChurn_KillSwitch_RestoresLegacyBehaviour(t *testing.T) {
+	t.Run("arm B brands the row unresolved again", func(t *testing.T) {
+		t.Setenv("DISABLE_ANTI_CHURN_DEFERRAL", "1")
