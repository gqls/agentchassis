+// the argument count. Widening the shared statement unconditionally is what
+// "failed twenty tests across eight files in lanes other sessions are working
+// right now" (load_work_item_actions.go's own comment); this test is what says
+// out loud that the deferral did not do that.
+func TestWriteWorkItem_NoTerminalSiblings_IsUnchanged(t *testing.T) {
+	db, mock := newInsertMock(t)
+	defer db.Close()
+
+	mock.ExpectBegin()
+	mock.ExpectQuery(regexp.QuoteMeta("SELECT COUNT(*),")).
+		WillReturnRows(sqlmock.NewRows([]string{"count", "age"}).AddRow(0, 999.0))
