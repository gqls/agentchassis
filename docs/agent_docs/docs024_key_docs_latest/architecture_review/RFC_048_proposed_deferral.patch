+// The two-strike defer must stay inside the stale-work-item-reaper's 48h ceiling
+// on a triaged row, or the fix trades a dead-letter for a reaped row and the
+// request is lost anyway — the same outcome by a slower route.
+//
+// maxBackoffMinutes is reused rather than minted precisely because its own
+// comment records that constraint. This test is what stops someone "tidying" the
+// deferral onto a fresh constant that does not carry it.
+func TestTwoStrikeDeferral_StaysInsideTheStaleReaperCeiling(t *testing.T) {
+	const reaperCeilingHours = 48
+	got := time.Duration(maxBackoffMinutes) * time.Minute
+	if got >= reaperCeilingHours*time.Hour {
+		t.Fatalf("two-strike deferral of %v reaches or exceeds the %dh reaper ceiling: a deferred "+
+			"row would be reaped to 'unresolved' before it could ever be claimed", got, reaperCeilingHours)
+	}
+	// Not merely "under" — there must be real headroom, because the reaper keys
+	// on created_at and the row is created NOW.
+	if headroom := reaperCeilingHours*time.Hour - got; headroom < 24*time.Hour {
+		t.Errorf("only %v of headroom below the reaper ceiling; want at least 24h", headroom)
+	}
+}
