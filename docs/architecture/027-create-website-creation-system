    query := `
        SELECT
            ai.id,
            ai.name,
            ai.config,
            ai.config->'capabilities' as capabilities,
            CASE
                WHEN ai.last_heartbeat > NOW() - INTERVAL '2 minutes' THEN 'active'
                ELSE 'inactive'
            END as status,
            am.success_rate,
            am.avg_response_time
        FROM client_demo_client.agent_instances ai
        LEFT JOIN agent_metrics am ON ai.id = am.agent_id
        WHERE ai.config->'capabilities' ?| $1  -- Has any required capability
        ORDER BY
            am.success_rate DESC NULLS LAST,
            am.avg_response_time ASC NULLS LAST
    `

