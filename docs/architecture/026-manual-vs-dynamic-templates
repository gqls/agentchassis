// Add metrics collection
type PerformanceObserver struct {
    // Track per step:
    Duration      time.Duration
    FuelConsumed  int
    ErrorRate     float64
    OutputQuality float64 // From human feedback
}

// During execution
func (o *Orchestrator) ExecuteWithObservation(ctx context.Context, group *AgentGroup) {
    observer := NewPerformanceObserver(group)

    // Execute normally but collect metrics
    result := o.Execute(ctx, group)

    metrics := observer.Analyze()
    o.storeMetrics(group.ID, metrics)

    // Trigger evolution check
    if metrics.NeedsImprovement() {
        o.evolutionService.Consider(group, metrics)
    }
}

Phase 3: Controlled Evolution (Week 3-4)
func (e *EvolutionService) Consider(group *AgentGroup, metrics Metrics) {
    // Only evolve if:
    // 1. Used more than N times (proven need)
    // 2. Has consistent bottleneck/issue
    // 3. Proposed change improves metric

    if group.UsageCount < 5 {
        return // Too early to evolve
    }

    if metrics.SuccessRate > 0.95 {
        return // Good enough
    }

    // Propose mutation
    mutation := e.proposeMutation(group, metrics)

    // Test in sandbox first
    testResult := e.sandbox.Test(group, mutation)

    if testResult.Improvement > 0.1 { // 10% better
        newGroup := e.applyMutation(group, mutation)
        newGroup.Version = incrementVersion(group.Version)
        newGroup.ParentID = group.ID
        e.save(newGroup)
    }
}

Key Design Decisions
1. Start Manual, Evolve Automatically

✅ Quality baseline guaranteed
✅ Predictable initial behavior
✅ Can always revert to v1
✅ Evolution is trackable

2. Constrained Evolution

✅ No "weird" runaway mutations
✅ Must improve metrics to survive
✅ Respects resource limits
✅ Maintains audit trail

