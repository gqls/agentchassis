Group Spawning Action

// platform/orchestration/actions/spawn_group.go
func SpawnGroupAction(ctx context.Context, params ActionParams) (interface{}, error) {
    groupType := params.StepConfig.Config["group_type"].(string)

    // Find best matching group
    var group AgentGroup
    err := params.DB.QueryRow(ctx, `
        SELECT * FROM client_demo_client.agent_groups
        WHERE group_type = $1
        AND capabilities @> $2
        ORDER BY usage_count DESC, version DESC
        LIMIT 1
    `, groupType, params.StepConfig.Config["required_capabilities"]).Scan(&group)

    if err != nil {
        // No existing group, create from template
        return createNewGroup(ctx, params)
    }

    // Spawn all agents in the group
    spawnedAgents := make(map[string]string)

    for _, agentConfig := range group.AgentConfigs {
        result, err := SpawnAgentAction(ctx, ActionParams{
            StepConfig: Step{
                Config: agentConfig,
            },
            // ... other params
        })

        if err != nil {
            return nil, fmt.Errorf("failed to spawn %s: %w", agentConfig.Role, err)
        }

        spawnedAgents[agentConfig.Role] = result["agent_id"]
    }

    // Update usage metrics
    params.DB.Exec(ctx, `
        UPDATE client_demo_client.agent_groups
        SET usage_count = usage_count + 1,
            last_used_at = NOW()
        WHERE id = $1
    `, group.ID)

    return map[string]interface{}{
        "group_id": group.ID,
        "agents": spawnedAgents,
        "workflow": group.OrchestrationWorkflow,
    }, nil
}

