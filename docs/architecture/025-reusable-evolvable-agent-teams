    "time"
)

func SpawnAgentAction(ctx context.Context, params ActionParams) (interface{}, error) {
    config := params.StepConfig.Config
    agentType := config["agent_type"].(string)

    // Check if we already have this agent for this client
    var existingAgent map[string]interface{}
    err := params.DB.QueryRow(ctx, `
        SELECT id, config
        FROM client_demo_client.agent_instances
        WHERE config->>'agent_type' = $1
        AND owner_user_id = $2
        AND is_active = true
        LIMIT 1
    `, agentType, params.Headers["client_id"]).Scan(&existingAgent)

    if err == nil {
        // Agent exists, reuse it
        return map[string]interface{}{
            "agent_id": existingAgent["id"],
            "topic": fmt.Sprintf("system.agent.%s.process", agentType),
            "status": "existing",
        }, nil
    }

    // Create new copywriter agent
    agentID := uuid.New().String()
    workflow := buildCopywriterWorkflow()

    agentConfig := map[string]interface{}{
        "agent_type": "copywriter",
        "workflow": workflow,
        "capabilities": []string{"writing", "marketing", "creative"},
        "llm_config": map[string]interface{}{
            "model": "claude-3-sonnet",
            "temperature": 0.8,
            "system_prompt": "You are an expert copywriter specializing in compelling marketing content.",
        },
    }

    // Insert into database
    _, err = params.DB.Exec(ctx, `
        INSERT INTO client_demo_client.agent_instances
        (id, template_id, owner_user_id, name, config, is_active)
        VALUES ($1, $2, $3, $4, $5, true)
    `,
        agentID,
        "2a540b98-85d5-4762-a692-538bcf1be395", // generic template
        params.Headers["client_id"],
        fmt.Sprintf("Copywriter-%s", time.Now().Format("20060102-150405")),
        agentConfig,
    )

    if err != nil {
        return nil, fmt.Errorf("failed to create agent: %w", err)
    }

    return map[string]interface{}{
        "agent_id": agentID,
        "topic": "system.agent.copywriter.process",
        "status": "created",
    }, nil
}

func buildCopywriterWorkflow() map[string]interface{} {
    return map[string]interface{}{
        "start_step": "analyze",
        "steps": map[string]interface{}{
            "analyze": map[string]interface{}{
                "action": "validate_input",
