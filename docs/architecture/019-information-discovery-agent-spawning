class AdaptiveTopicAgent:
    def __init__(self, topic, parent_domain):
        # Inherit successful patterns from domain
        self.search_patterns = parent_domain.get_successful_patterns()
        self.quality_signals = parent_domain.get_quality_indicators()

    def discover_information(self):
