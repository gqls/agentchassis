The Case for Mandatory AgentID
1. Complete Traceability
# With mandatory IDs, we can trace:
topic_coordinator[id: tc-001]
  → data_collector[id: dc-prod-v2]
    → news_api_agent[id: news-west-1]
    → social_api_agent[id: social-east-2]
  → entity_extractor[id: ee-gpu-cluster-3]

# Every call is traceable to specific instances
2. Version Management
type AgentInstance struct {
    ID          string  // "analyzer-prod-v3-instance-1"
    Type        string  // "analyzer"
    Version     string  // "3.0.1"
    Deployed    time.Time
    Workflow    WorkflowPlan
}

// Now we can:
// - Route to specific versions
// - A/B test workflows
// - Gradual rollouts
// - Track which version processed what

